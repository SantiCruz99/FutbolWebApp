Use cWebView.pkg
Use cWebPanel.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cequipoDataDictionary.dd

Object oSelectEquipo is a cWebView
    Set piWidth to 800
    Set psCaption to "Seleccionar Equipo"
    Set peViewType to vtSelect

    // Propiedad para filtrar por liga
    Property String psLigaID ""

    // Indica si se ha abierto desde ZoomEntrenador
    Property String psModoSeleccion ""

    // Guarda el RowID del equipo seleccionado
    Property String psEquipoRowId ""

    Object oEquipo_DD is a cequipoDataDictionary

        Procedure Constrain
            Forward Send Constrain

            String sLigaID

            Get psLigaID of oSelectEquipo to sLigaID

            If (sLigaID <> "") Begin
                Constrain equipo.LigaID eq sLigaID
            End
        End_Procedure

    End_Object

    Set Main_DD to oEquipo_DD

    // Capturamos los parámetros de navegación
    Procedure OnNavigateForward tWebNavigateData NavigateData
        String sLigaID
        String sModo

        Forward Send OnNavigateForward NavigateData

        Get NamedValueGet NavigateData.NamedValues "LigaID" to sLigaID
        Get NamedValueGet NavigateData.NamedValues "ModoSeleccion" to sModo

        Set psLigaID to sLigaID
        Set psModoSeleccion to sModo
        Set psEquipoRowId to ""

        Send RebuildAllConstraints of oEquipo_DD
        Send Clear of oEquipo_DD
        Send Find of oEquipo_DD FIRST_RECORD 1
    End_Procedure

    Procedure OnLoad
        Forward Send OnLoad

        Set psLigaID to ""
        Set psModoSeleccion to ""
        Set psEquipoRowId to ""

        Send RebuildAllConstraints of oEquipo_DD
        Send Clear of oEquipo_DD
        Send Find of oEquipo_DD FIRST_RECORD 1
    End_Procedure

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object oEquipoList is a cWebList
            Set piColumnSpan to 12
            Set pbFillHeight to True
            Set Server to oEquipo_DD
            Set pbServerOnRowClick to True
            Set psCSSClass to "tabla-verde-custom"

            // Ruta habitual hacia ZoomEquipo
            WebRegisterPath ntNavigateForward oZoomEquipo

            Object oID is a cWebColumn
                Entry_Item equipo.ID
                Set psCaption to "ID"
                Set piWidth to 20
            End_Object

            Object oNombre is a cWebColumn
                Entry_Item equipo.Nombre
                Set psCaption to "Nombre"
                Set piWidth to 50
            End_Object

            Object oLigaID is a cWebColumn
                Entry_Item equipo.LigaID
                Set psCaption to "Liga ID"
                Set piWidth to 30
            End_Object

            // Al pulsar una fila decidimos según el origen
            Procedure OnRowClick String sRowID
                String sModo

                Get psModoSeleccion of oSelectEquipo to sModo

                If (sModo = "Entrenador") Begin
                    // Guardamos el RowID de la fila seleccionada
                    Set psEquipoRowId of oSelectEquipo to sRowID

                    // Devolvemos el equipo al ZoomEntrenador
                    Send NavigateClose of oSelectEquipo Self
                End
                Else Begin
                    // Comportamiento original: abrir ZoomEquipo
                    Send NavigatePath
                End
            End_Procedure

            // Pasamos el RowID a ZoomEquipo
            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                RowID riEquipo
                String sRowId

                Forward Send OnGetNavigateForwardData (&NavigateData) hoToView

                Get CurrentRowId of oEquipo_DD to riEquipo
                Move (SerializeRowId(riEquipo)) to sRowId

                Get NamedValueAdd NavigateData.NamedValues ;
                    "EquipoRowId" sRowId to NavigateData.NamedValues
            End_Procedure

            // Devolvemos el equipo elegido al ZoomEntrenador
            Procedure OnGetNavigateBackData tWebNavigateData ByRef NavigateData Handle hoBackToView
                String sRowId

                Forward Send OnGetNavigateBackData (&NavigateData) hoBackToView

                Get psEquipoRowId of oSelectEquipo to sRowId

                If (sRowId <> "") Begin
                    Get NamedValueAdd NavigateData.NamedValues ;
                        "EquipoRowId" sRowId to NavigateData.NamedValues
                End
            End_Procedure

        End_Object
    End_Object

End_Object


