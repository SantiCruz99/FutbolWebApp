Use cWebView.pkg
Use cWebPanel.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cposicionDataDictionary.dd

Object oSelectPosicion is a cWebView
    Set piWidth to 500
    Set psCaption to "Seleccionar Posición"
    Set peViewType to vtSelect

    Object oPosicion_DD is a cposicionDataDictionary
    End_Object

    Set Main_DD to oPosicion_DD

    Procedure OnLoad
        Forward Send OnLoad
        Send Find of oPosicion_DD FIRST_RECORD 1
    End_Procedure

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object oPosicionList is a cWebList
            Set piColumnSpan to 12
            Set pbFillHeight to True
            Set Server to oPosicion_DD
            Set pbServerOnRowClick to True

            // Registramos la ruta de navegación hacia la vista de detalle/zoom
            WebRegisterPath ntNavigateForward oZoomPosicion

            Object oID is a cWebColumn
                Entry_Item posicion.ID
                Set psCaption to "ID"
                Set piWidth to 15
            End_Object

            Object oNombre is a cWebColumn
                Entry_Item posicion.Nombre
                Set psCaption to "Nombre"
                Set piWidth to 70
            End_Object

            // Al hacer clic en la fila, ejecutamos la navegación
            Procedure OnRowClick String sRowID
                Send NavigatePath
            End_Procedure

            // Pasamos el RowId de la posición seleccionada al Zoom
            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                RowID riPosicion
                String sRowId

                Forward Send OnGetNavigateForwardData (&NavigateData) hoToView

                Get CurrentRowId of oPosicion_DD to riPosicion
                Move (SerializeRowId(riPosicion)) to sRowId
                Get NamedValueAdd NavigateData.NamedValues "PosicionRowId" sRowId to NavigateData.NamedValues
            End_Procedure

        End_Object
    End_Object
End_Object