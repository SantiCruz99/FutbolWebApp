
Use cWebView.pkg
Use cWebPanel.pkg
Use cWebForm.pkg
Use cWebButton.pkg
Use cWebGroup.pkg
Use cWebSpacer.pkg
Use cWebHtmlBox.pkg
Use cWebMenuGroup.pkg
Use cWebMenuItem.pkg
Use cWebLabel.pkg
Use cWebList.pkg
Use cWebColumn.pkg

Object oDashboard is a cWebView

    Set piMaxWidth to 1024
    Set psCaption to "Dashboard"
    Set peViewType to vtUndefined
    Set pbShowCaption to False
    Set psCSSClass to "Dashboard"

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 24

        WebSetResponsive piColumnCount rmMobile to 1
        WebSetResponsive piColumnCount rmTabletPortrait to 16

        Object oTiles_grp is a cWebGroup
            Set piColumnSpan to 8
            Set pbShowBorder to False
            Set pbShowCaption to False
            Set piColumnCount to 12
            Set psCSSClass to "TilesGroup"

            // TILE 1: WELCOME
            Object oTileWelcome is a cWebHtmlBox
                Set pbServerOnClick to False
                Set piColumnIndex to 0
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Light"
                Set psHtml to '<div class="WebCon_Sizer"><div class="Tile_Title">Welcome</div><div class="Tile_Subtitle">Admin</div></div>'
            End_Object

            // TILE 2: ENTRENADORES
            Object oTileEntrenador is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnIndex to 6
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Light"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="Tile_Title">Entrenadores</div><div class="Tile_Subtitle">Gestionar entrenadores</div></div>'

                WebRegisterPath ntNavigateForward oSelectEntrenador

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            // TILE 3: JUGADORES
            Object oTileJugador is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set piColumnIndex to 0
                Set psCSSClass to "Tile LightAlternate"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="Tile_Title">Jugadores</div><div class="Tile_Subtitle">Gestionar jugadores</div></div>'

                WebRegisterPath ntNavigateForward oSelectJugador

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            // TILE 4: POSICIONES
            Object oTilePosicion is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnIndex to 6
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Dark"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="Tile_Title">Posiciones</div><div class="Tile_Subtitle">Consultar posiciones</div></div>'

                WebRegisterPath ntNavigateForward oSelectPosicion

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            // TILE 5: EQUIPOS
            Object oTileEquipo is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnSpan to 6
                Set piColumnIndex to 0
                Set psCSSClass to "Tile DarkAlternate"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="Tile_Title">Equipos</div><div class="Tile_Subtitle">Gestionar equipos</div></div>'

                WebRegisterPath ntNavigateForward oSelectEquipo

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

            // TILE 6: LIGAS
            Object oTileLiga is a cWebHtmlBox
                Set pbServerOnClick to True
                Set piColumnIndex to 6
                Set piColumnSpan to 6
                Set psCSSClass to "Tile Light"
                Set psHtml to '<div class="WebCon_Sizer" data-ServerOnClick="openview"><div class="Tile_Title">Ligas</div><div class="Tile_Subtitle">Gestionar ligas</div></div>'

                WebRegisterPath ntNavigateForward oSelectLiga

                Procedure OnClick String sId String sParam
                    Send NavigatePath
                End_Procedure
            End_Object

        End_Object
    End_Object

End_Object
