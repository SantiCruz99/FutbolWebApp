
Use cWebView.pkg
Use cWebPanel.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use cligaDataDictionary.dd

Object oSelectLiga is a cWebView
    Set piWidth to 900
    Set psCaption to "Seleccionar liga"

    Object oLiga_DD is a cligaDataDictionary
    End_Object

    Set Main_DD to oLiga_DD

    Procedure OnLoad
        Forward Send OnLoad
        Send Find of oLiga_DD FIRST_RECORD 1
    End_Procedure

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12
        
        Object oLigaList is a cWebList
            Set piColumnSpan to 12
            Set pbFillHeight to True
            Set Server to oLiga_DD
            Set pbServerOnRowClick to True

            WebRegisterPath ntNavigateForward oSelectEquipo

            Object oID is a cWebColumn
                Entry_Item liga.ID
                Set psCaption to "ID"
                Set piWidth to 15
            End_Object

            Object oNombre is a cWebColumn
                Entry_Item liga.Nombre
                Set psCaption to "Nombre"
                Set piWidth to 35
            End_Object

            Object oPais is a cWebColumn
                Entry_Item liga.Pais
                Set psCaption to "País"
                Set piWidth to 25
            End_Object

            Object oEquipos is a cWebColumn
                Entry_Item liga.Equipos
                Set psCaption to "Equipos"
                Set piWidth to 25
            End_Object

            Procedure OnRowClick String sRowID
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                String sLigaID

                Move (String(liga.ID)) to sLigaID

                Get NamedValueAdd NavigateData.NamedValues "LigaID" sLigaID to NavigateData.NamedValues
            End_Procedure

        End_Object
        
    End_Object  

End_Object