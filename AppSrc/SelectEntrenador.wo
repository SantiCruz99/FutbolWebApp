Use cWebView.pkg
Use cWebPanel.pkg
Use cWebList.pkg
Use cWebColumn.pkg
Use centrenadorDataDictionary.dd

Object oSelectEntrenador is a cWebView
    Set piWidth to 600
    Set psCaption to "Seleccionar Entrenador"
    Set peViewType to vtSelect

    Object oEntrenador_DD is a centrenadorDataDictionary
    End_Object

    Set Main_DD to oEntrenador_DD

    Object oWebMainPanel is a cWebPanel
        Set piColumnCount to 12

        Object oEntrenadorList is a cWebList
            Set piColumnSpan to 12
            Set pbFillHeight to True
            Set Server to oEntrenador_DD
            Set pbServerOnRowClick to True

            WebRegisterPath ntNavigateForward oZoomEntrenador

            Object oID is a cWebColumn
                Entry_Item entrenador.ID
                Set psCaption to "ID"
                Set piWidth to 10
            End_Object

            Object oNombre is a cWebColumn
                Entry_Item entrenador.Nombre
                Set psCaption to "Nombre"
                Set piWidth to 25
            End_Object

            Object oApellido is a cWebColumn
                Entry_Item entrenador.Apellido
                Set psCaption to "Apellido"
                Set piWidth to 25
            End_Object

            Object oNacionalidad is a cWebColumn
                Entry_Item entrenador.Nacionalidad
                Set psCaption to "Nacionalidad"
                Set piWidth to 20
            End_Object

            Object oEquipoID is a cWebColumn
                Entry_Item entrenador.EquipoID
                Set psCaption to "Equipo ID"
                Set piWidth to 20
            End_Object

            Procedure OnRowClick String sRowID
                Send NavigatePath
            End_Procedure

            Procedure OnGetNavigateForwardData tWebNavigateData ByRef NavigateData Handle hoToView
                RowID  riEntrenador
                String sRowId

                Forward Send OnGetNavigateForwardData (&NavigateData) hoToView

                Get CurrentRowId of oEntrenador_DD to riEntrenador
                Move (SerializeRowId(riEntrenador)) to sRowId
                Get NamedValueAdd NavigateData.NamedValues "EntrenadorRowId" sRowId to NavigateData.NamedValues
            End_Procedure

        End_Object
    End_Object
End_Object