39239>>>        Get HasRecord of oJugadorPosicionSave_DD to bTieneRegistro
39240>>>
39240>>>        If (bTieneRegistro) Begin
39242>>>            Send UserError "El DDO de inserción contiene un registro anterior. Se cancela el guardado." "ERROR"
39243>>>            Procedure_Return
39244>>>        End
39244>>>>
39244>>>
39244>>>
39244>>>        // PASO 9: Validar los campos obligatorios
39244>>>        Get Request_Validate of oJugadorPosicionSave_DD to bError
39245>>>
39245>>>        If (bError) Begin
39247>>>            Send UserError "No se pueden validar JugadorID y PosicionID" "ERROR"
39248>>>            Procedure_Return
39249>>>        End
