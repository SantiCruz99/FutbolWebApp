36801>>>>>>>        Define C_PWH_PBKDF2_HMAC_SHA_256        for 0 // Requires TimeCost
36801>>>>>>>        Define C_PWH_PBKDF2_HMAC_SHA_512              // Requires TimeCost
36801>>>>>>>    End_Enum_List
36801>>>>>>>    
36801>>>>>>>    Function RandomBuffer UInteger uiSize Returns UChar[]
36803>>>>>>>        UChar[] ucaBuffer
36804>>>>>>>        Move (ResizeArray(ucaBuffer, uiSize)) to ucaBuffer
36805>>>>>>>        If (CNG_BCryptGenRandom(0, AddressOf(ucaBuffer), uiSize, |CI$00000002 /*BCRYPT_USE_SYSTEM_PREFERRED_RNG*/)) Begin
36807>>>>>>>            Error 8710 "Failed to create random buffer."
36808>>>>>>>>
36808>>>>>>>        End
36808>>>>>>>>
36808>>>>>>>        Function_Return ucaBuffer
36809>>>>>>>    End_Function
36810>>>>>>>    
36810>>>>>>>    Function Base64EncodeArr UChar[] ucaBuffer Returns String
36812>>>>>>>        Integer iErr
36812>>>>>>>        Pointer pBase64
36812>>>>>>>        String sBase64
36812>>>>>>>        Move (Base64Encode(AddressOf(ucaBuffer), SizeOfArray(ucaBuffer))) to pBase64
36813>>>>>>>        If (not(pBase64)) Begin
36815>>>>>>>            Function_Return sBase64
36816>>>>>>>        End
36816>>>>>>>>
36816>>>>>>>        Move (PointerToString(pBase64)) to sBase64
36817>>>>>>>        Move (Free(pBase64)) to iErr
36818>>>>>>>        Function_Return sBase64
36819>>>>>>>    End_Function
36820>>>>>>>    
36820>>>>>>>    Function Base64DecodeArr String sBase64 Returns UChar[]
36822>>>>>>>        Integer iLen
36822>>>>>>>        Pointer pBase64
36822>>>>>>>        UChar[] ucaBuffer
36823>>>>>>>        Move (Base64Decode(AddressOf(sBase64), &iLen)) to pBase64
36824>>>>>>>        If (not(pBase64)) Begin
36826>>>>>>>            Function_Return ucaBuffer
36827>>>>>>>        End
36827>>>>>>>>
36827>>>>>>>        
36827>>>>>>>        Move (ResizeArray(ucaBuffer, iLen)) to ucaBuffer
36828>>>>>>>        Move (MemCopy(AddressOf(ucaBuffer), pBase64, iLen)) to iLen
36829>>>>>>>        Move (Free(pBase64)) to iLen
36830>>>>>>>        Function_Return ucaBuffer
36831>>>>>>>    End_Function
36832>>>>>>>    
36832>>>>>>>    Function CreatePasswordHashExWithSalt UInteger uiAlgo UChar[] ucaSalt String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36834>>>>>>>        Boolean bOk bRequireTimeCost
36834>>>>>>>        UChar[] ucaHash
36835>>>>>>>        
36835>>>>>>>        Case Begin
36835>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36837>>>>>>>                Get CNG_PBKDF2_HMAC "SHA256" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36838>>>>>>>                If (not(bOk)) Function_Return False
36841>>>>>>>                
36841>>>>>>>                Move True to bRequireTimeCost
36842>>>>>>>                Case Break
36843>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36846>>>>>>>                Get CNG_PBKDF2_HMAC "SHA512" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36847>>>>>>>                If (not(bOk)) Function_Return False
36850>>>>>>>                
36850>>>>>>>                Move True to bRequireTimeCost
36851>>>>>>>                Case Break
36852>>>>>>>            Case Else
36852>>>>>>>                Error 8710 "Invalid algorithm selected."
36853>>>>>>>>
36853>>>>>>>                Function_Return False
36854>>>>>>>        Case End
36854>>>>>>>        
36854>>>>>>>        String sSalt
36854>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36855>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36858>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36859>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36862>>>>>>>        
36862>>>>>>>        If (bRequireTimeCost) Begin
36864>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36865>>>>>>>        End
36865>>>>>>>>
36865>>>>>>>        Else Begin
36866>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36867>>>>>>>        End
36867>>>>>>>>
36867>>>>>>>        
36867>>>>>>>        Function_Return bOk
36868>>>>>>>    End_Function
36869>>>>>>>    
36869>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36871>>>>>>>        UChar[] ucaSalt
36872>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36873>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36876>>>>>>>        
36876>>>>>>>        If (num_arguments > 4) Begin
36878>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36879>>>>>>>        End
36879>>>>>>>>
36879>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36880>>>>>>>    End_Function
36881>>>>>>>    
36881>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36883>>>>>>>        Boolean bRequiresTimeCost
36883>>>>>>>        UInteger uiAlgo uiTimeCost
36883>>>>>>>        Integer iBegin iEnd
36883>>>>>>>        String sSalt
36883>>>>>>>        
36883>>>>>>>        Move 1 to iBegin
36884>>>>>>>        
36884>>>>>>>        // Parse Algo
36884>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36885>>>>>>>        If (not(iEnd)) Function_Return False
36888>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36889>>>>>>>        
36889>>>>>>>        // Parse Salt
36889>>>>>>>        Move (iEnd + 1) to iBegin
36890>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36891>>>>>>>        If (not(iEnd)) Function_Return False
36894>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36895>>>>>>>        
36895>>>>>>>        Case Begin
36895>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36897>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36900>>>>>>>                Move True to bRequiresTimeCost
36901>>>>>>>                Case Break
36902>>>>>>>            Case Else
36902>>>>>>>                Error 8710 "Invalid algorithm selected."
36903>>>>>>>>
36903>>>>>>>                Function_Return False
36904>>>>>>>        Case End
36904>>>>>>>        
36904>>>>>>>        // Parse optional timecost
36904>>>>>>>        If (bRequiresTimeCost) Begin
36906>>>>>>>            Move (iEnd + 1) to iBegin
36907>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36908>>>>>>>            If (not(iEnd)) Function_Return False
36911>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36912>>>>>>>        End
36912>>>>>>>>
36912>>>>>>>        
36912>>>>>>>        // Parse rest hash
36912>>>>>>>        Move (iEnd + 1) to iBegin
36913>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36914>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36917>>>>>>>        
36917>>>>>>>        // Base64Decode
36917>>>>>>>        UChar[] ucaSalt
36918>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36919>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36922>>>>>>>        
36922>>>>>>>        // Create new hash
36922>>>>>>>        String sNewHash
36922>>>>>>>        If (bRequiresTimeCost) Begin
36924>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36926>>>>>>>                Function_Return False 
36927>>>>>>>            End
36927>>>>>>>>
36927>>>>>>>        End
36927>>>>>>>>
36927>>>>>>>        Else Begin
36928>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36930>>>>>>>                Function_Return False 
36931>>>>>>>            End
36931>>>>>>>>
36931>>>>>>>        End
36931>>>>>>>>
36931>>>>>>>        Function_Return (sNewHash = sHash)
36932>>>>>>>    End_Function
36933>>>>>>>    
36933>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36935>>>>>>>        Boolean bRequireTimeCost
36935>>>>>>>        UBigInt ullSize
36935>>>>>>>        UChar[] ucaSalt
36936>>>>>>>        String sSalt
36936>>>>>>>        
36936>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36937>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36938>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36941>>>>>>>        
36941>>>>>>>        Case Begin
36941>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36943>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36944>>>>>>>                Move True to bRequireTimeCost
36945>>>>>>>                Case Break
36946>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36949>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36950>>>>>>>                Move True to bRequireTimeCost
36951>>>>>>>                Case Break
36952>>>>>>>            Case Else
36952>>>>>>>                Error 8710 "Invalid algorithm selected."
36953>>>>>>>>
36953>>>>>>>                Function_Return 0
36954>>>>>>>        Case End
36954>>>>>>>        
36954>>>>>>>        // calculate base64 in a non-floating-manner
36954>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36955>>>>>>>        
36955>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36956>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36957>>>>>>>        If (bRequireTimeCost) Begin
36959>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36960>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36961>>>>>>>        End
36961>>>>>>>>
36961>>>>>>>        Else Begin
36962>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36963>>>>>>>        End
36963>>>>>>>>
36963>>>>>>>        
36963>>>>>>>        Function_Return ullSize
36964>>>>>>>    End_Function
36965>>>>>>>End_Class
36966>>>>>>>
36966>>>>>>>Class cPasswordHasher is a cObject
36967>>>>>>>    
36967>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36968>>>>>>>    
36968>>>>>>>    Procedure Construct_Object
36970>>>>>>>        Forward Send Construct_Object
36972>>>>>>>        
36972>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36973>>>>>>>        Property UInteger   puiSaltSize         16
36974>>>>>>>        
36974>>>>>>>        Property UInteger   puiOptTimeCost      420000
36975>>>>>>>    End_Procedure
36976>>>>>>>    
36976>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36978>>>>>>>        Boolean bOk
36978>>>>>>>        UInteger uiAlgo
36978>>>>>>>        Get peAlgorithm to uiAlgo
36979>>>>>>>        
36979>>>>>>>        Case Begin
36979>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36981>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36984>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36985>>>>>>>                Case Break
36986>>>>>>>            Case Else
36986>>>>>>>                Error 8710 "Invalid algorithm selected."
36987>>>>>>>>
36987>>>>>>>                Function_Return False
36988>>>>>>>        Case End
36988>>>>>>>        
36988>>>>>>>        Function_Return bOk
36989>>>>>>>    End_Function
36990>>>>>>>    
36990>>>>>>>    Function RequiredBufferSize Returns UBigInt
36992>>>>>>>        UBigInt ullSize
36992>>>>>>>        UInteger uiAlgo
36992>>>>>>>        Get peAlgorithm to uiAlgo
36993>>>>>>>        
36993>>>>>>>        Case Begin
36993>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36995>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36998>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36999>>>>>>>                Case Break
37000>>>>>>>            Case Else
37000>>>>>>>                Error 8710 "Invalid algorithm selected."
37001>>>>>>>>
37001>>>>>>>                Function_Return 0
37002>>>>>>>        Case End
37002>>>>>>>        
37002>>>>>>>        Function_Return ullSize
37003>>>>>>>    End_Function
37004>>>>>>>
37004>>>>>>>End_Class
