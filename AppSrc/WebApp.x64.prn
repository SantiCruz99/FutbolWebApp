39256>>>    // =====================================================
39256>>>    // QUITAR UNA POSICIÓN DEL JUGADOR
39256>>>    // =====================================================
39256>>>
39256>>>    Procedure QuitarPosicion
39259>>>
39259>>>        Integer iJugadorID
39259>>>        Integer iRelacionID
39259>>>        Integer iPosicionID
39259>>>        Boolean bError
39259>>>
39259>>>        Get piJugadorID to iJugadorID
39260>>>        Get piJugadorPosicionSeleccionada to iRelacionID
39261>>>        Get piPosicionDerechaSeleccionada to iPosicionID
39262>>>
39262>>>        // Comprobar que se ha seleccionado una asignación en la derecha
39262>>>        If (iRelacionID <= 0) Begin
39264>>>            Send UserError "Selecciona primero la posición que deseas quitar en la lista derecha" "AVISO"
39265>>>            Procedure_Return
39266>>>        End
39266>>>>
39266>>>
39266>>>        If (iJugadorID <= 0) Begin
39268>>>            Send UserError "No se ha seleccionado un jugador válido" "ERROR"
39269>>>            Procedure_Return
39270>>>        End
39270>>>>
39270>>>
39270>>>
39270>>>        // Recuperar el jugador padre actual
39270>>>        Send Clear_All of oJugadorPosicion_DD
39271>>>
39271>>>        Move iJugadorID to jugador.ID
39272>>>        Send Find of oJugador_DD EQ 1
39273>>>
39273>>>        If (not(Found)) Begin
39275>>>            Send UserError "No se ha encontrado el jugador" "ERROR"
39276>>>            Procedure_Return
39277>>>        End
39277>>>>
39277>>>
39277>>>
39277>>>        // Reconstruir el filtro correspondiente al jugador actual
39277>>>        Send RebuildAllConstraints of oJugadorPosicion_DD
39278>>>
39278>>>
39278>>>        // Recuperar solamente la relación seleccionada
39278>>>        Move iRelacionID to jugadorposicion.ID
39279>>>        Send Find of oJugadorPosicion_DD EQ 1
39280>>>
39280>>>        If (not(Found)) Begin
39282>>>            Send UserError "La asignación seleccionada ya no existe para este jugador" "ERROR"
39283>>>            Procedure_Return
39284>>>        End
39284>>>>
39284>>>
39284>>>
39284>>>        // Comprobar que la relación pertenece al jugador actual
39284>>>        If (jugadorposicion.JugadorID <> iJugadorID) Begin
39286>>>            Send UserError "La posición seleccionada no pertenece a este jugador" "ERROR"
39287>>>            Procedure_Return
39288>>>        End
39288>>>>
39288>>>
39288>>>        If (jugadorposicion.PosicionID <> iPosicionID) Begin
39290>>>            Send UserError "La asignación seleccionada ha cambiado. Vuelve a seleccionarla" "ERROR"
39291>>>            Procedure_Return
39292>>>        End
39292>>>>
39292>>>
39292>>>
39292>>>        // Eliminar únicamente la relación jugador-posicion seleccionada
39292>>>        Send Request_Delete of oJugadorPosicion_DD
39293>>>
39293>>>        Move (Err) to bError
39294>>>
39294>>>        If (bError) Begin
39296>>>            Send UserError "No se pudo quitar la posición del jugador" "ERROR"
39297>>>            Procedure_Return
39298>>>        End
39298>>>>
39298>>>
39298>>>
39298>>>        // Limpiar las selecciones
39298>>>        Set piJugadorPosicionSeleccionada to 0
39299>>>        Set piPosicionDerechaSeleccionada to 0
39300>>>        Set piPosicionSeleccionada to 0
39301>>>
39301>>>
39301>>>        // Actualizar las posiciones asignadas
39301>>>        Send CargarPosicionesAsignadas
39302>>>
39302>>>        // Mantener la lista izquierda completa
39302>>>        Send CargarPosicionesDisponibles
39303>>>
39303>>>    End_Procedure
39304>>>
