36788>>>>>>>        If (CNG_BCryptGenRandom(0, AddressOf(ucaBuffer), uiSize, |CI$00000002 /*BCRYPT_USE_SYSTEM_PREFERRED_RNG*/)) Begin
36790>>>>>>>            Error 8710 "Failed to create random buffer."
36791>>>>>>>>
36791>>>>>>>        End
36791>>>>>>>>
36791>>>>>>>        Function_Return ucaBuffer
36792>>>>>>>    End_Function
36793>>>>>>>    
36793>>>>>>>    Function Base64EncodeArr UChar[] ucaBuffer Returns String
36795>>>>>>>        Integer iErr
36795>>>>>>>        Pointer pBase64
36795>>>>>>>        String sBase64
36795>>>>>>>        Move (Base64Encode(AddressOf(ucaBuffer), SizeOfArray(ucaBuffer))) to pBase64
36796>>>>>>>        If (not(pBase64)) Begin
36798>>>>>>>            Function_Return sBase64
36799>>>>>>>        End
36799>>>>>>>>
36799>>>>>>>        Move (PointerToString(pBase64)) to sBase64
36800>>>>>>>        Move (Free(pBase64)) to iErr
36801>>>>>>>        Function_Return sBase64
36802>>>>>>>    End_Function
36803>>>>>>>    
36803>>>>>>>    Function Base64DecodeArr String sBase64 Returns UChar[]
36805>>>>>>>        Integer iLen
36805>>>>>>>        Pointer pBase64
36805>>>>>>>        UChar[] ucaBuffer
36806>>>>>>>        Move (Base64Decode(AddressOf(sBase64), &iLen)) to pBase64
36807>>>>>>>        If (not(pBase64)) Begin
36809>>>>>>>            Function_Return ucaBuffer
36810>>>>>>>        End
36810>>>>>>>>
36810>>>>>>>        
36810>>>>>>>        Move (ResizeArray(ucaBuffer, iLen)) to ucaBuffer
36811>>>>>>>        Move (MemCopy(AddressOf(ucaBuffer), pBase64, iLen)) to iLen
36812>>>>>>>        Move (Free(pBase64)) to iLen
36813>>>>>>>        Function_Return ucaBuffer
36814>>>>>>>    End_Function
36815>>>>>>>    
36815>>>>>>>    Function CreatePasswordHashExWithSalt UInteger uiAlgo UChar[] ucaSalt String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36817>>>>>>>        Boolean bOk bRequireTimeCost
36817>>>>>>>        UChar[] ucaHash
36818>>>>>>>        
36818>>>>>>>        Case Begin
36818>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36820>>>>>>>                Get CNG_PBKDF2_HMAC "SHA256" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36821>>>>>>>                If (not(bOk)) Function_Return False
36824>>>>>>>                
36824>>>>>>>                Move True to bRequireTimeCost
36825>>>>>>>                Case Break
36826>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36829>>>>>>>                Get CNG_PBKDF2_HMAC "SHA512" (StringToUCharArray(sPassword)) ucaSalt uiOptTimeCost (&ucaHash) False to bOk
36830>>>>>>>                If (not(bOk)) Function_Return False
36833>>>>>>>                
36833>>>>>>>                Move True to bRequireTimeCost
36834>>>>>>>                Case Break
36835>>>>>>>            Case Else
36835>>>>>>>                Error 8710 "Invalid algorithm selected."
36836>>>>>>>>
36836>>>>>>>                Function_Return False
36837>>>>>>>        Case End
36837>>>>>>>        
36837>>>>>>>        String sSalt
36837>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36838>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return False
36841>>>>>>>        Get Base64EncodeArr ucaHash to sHash
36842>>>>>>>        If (not(SizeOfString(sHash))) Function_Return False
36845>>>>>>>        
36845>>>>>>>        If (bRequireTimeCost) Begin
36847>>>>>>>            Move (SFormat("%1$%2$%3$%4",            ;                            String(uiAlgo),         ;                            sSalt,                  ;                            String(uiOptTimeCost),  ;                            sHash)) to sHash
36848>>>>>>>        End
36848>>>>>>>>
36848>>>>>>>        Else Begin
36849>>>>>>>            Move (SFormat("%1$%2$%3",               ;                            String(uiAlgo),         ;                            sSalt,                  ;                            sHash)) to sHash
36850>>>>>>>        End
36850>>>>>>>>
36850>>>>>>>        
36850>>>>>>>        Function_Return bOk
36851>>>>>>>    End_Function
36852>>>>>>>    
36852>>>>>>>    Function CreatePasswordHashEx UInteger uiAlgo UInteger uiSaltSize String sPassword String ByRef sHash UInteger uiOptTimeCost Returns Boolean
36854>>>>>>>        UChar[] ucaSalt
36855>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36856>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36859>>>>>>>        
36859>>>>>>>        If (num_arguments > 4) Begin
36861>>>>>>>            Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash, uiOptTimeCost))
36862>>>>>>>        End
36862>>>>>>>>
36862>>>>>>>        Function_Return (CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sHash))
36863>>>>>>>    End_Function
36864>>>>>>>    
36864>>>>>>>    Function VerifyPasswordHash String sPassword String sHash Returns Boolean
36866>>>>>>>        Boolean bRequiresTimeCost
36866>>>>>>>        UInteger uiAlgo uiTimeCost
36866>>>>>>>        Integer iBegin iEnd
36866>>>>>>>        String sSalt
36866>>>>>>>        
36866>>>>>>>        Move 1 to iBegin
36867>>>>>>>        
36867>>>>>>>        // Parse Algo
36867>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36868>>>>>>>        If (not(iEnd)) Function_Return False
36871>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiAlgo
36872>>>>>>>        
36872>>>>>>>        // Parse Salt
36872>>>>>>>        Move (iEnd + 1) to iBegin
36873>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36874>>>>>>>        If (not(iEnd)) Function_Return False
36877>>>>>>>        Move (Mid(sHash, iEnd - iBegin, iBegin)) to sSalt
36878>>>>>>>        
36878>>>>>>>        Case Begin
36878>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36880>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36883>>>>>>>                Move True to bRequiresTimeCost
36884>>>>>>>                Case Break
36885>>>>>>>            Case Else
36885>>>>>>>                Error 8710 "Invalid algorithm selected."
36886>>>>>>>>
36886>>>>>>>                Function_Return False
36887>>>>>>>        Case End
36887>>>>>>>        
36887>>>>>>>        // Parse optional timecost
36887>>>>>>>        If (bRequiresTimeCost) Begin
36889>>>>>>>            Move (iEnd + 1) to iBegin
36890>>>>>>>            Move (Pos("$", sHash, iBegin)) to iEnd
36891>>>>>>>            If (not(iEnd)) Function_Return False
36894>>>>>>>            Move (Mid(sHash, iEnd - iBegin, iBegin)) to uiTimeCost
36895>>>>>>>        End
36895>>>>>>>>
36895>>>>>>>        
36895>>>>>>>        // Parse rest hash
36895>>>>>>>        Move (iEnd + 1) to iBegin
36896>>>>>>>        Move (Pos("$", sHash, iBegin)) to iEnd
36897>>>>>>>        If (iEnd) Function_Return False // inverse check if there are any other errors.
36900>>>>>>>        
36900>>>>>>>        // Base64Decode
36900>>>>>>>        UChar[] ucaSalt
36901>>>>>>>        Get Base64DecodeArr sSalt to ucaSalt
36902>>>>>>>        If (not(SizeOfArray(ucaSalt))) Function_Return False
36905>>>>>>>        
36905>>>>>>>        // Create new hash
36905>>>>>>>        String sNewHash
36905>>>>>>>        If (bRequiresTimeCost) Begin
36907>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash, uiTimeCost))) Begin
36909>>>>>>>                Function_Return False 
36910>>>>>>>            End
36910>>>>>>>>
36910>>>>>>>        End
36910>>>>>>>>
36910>>>>>>>        Else Begin
36911>>>>>>>            If (not(CreatePasswordHashExWithSalt(Self, uiAlgo, ucaSalt, sPassword, &sNewHash))) Begin
36913>>>>>>>                Function_Return False 
36914>>>>>>>            End
36914>>>>>>>>
36914>>>>>>>        End
36914>>>>>>>>
36914>>>>>>>        Function_Return (sNewHash = sHash)
36915>>>>>>>    End_Function
36916>>>>>>>    
36916>>>>>>>    Function RequiredBufferSizeEx UInteger uiAlgo UInteger uiSaltSize UInteger uiOptTimeCost Returns UBigInt
36918>>>>>>>        Boolean bRequireTimeCost
36918>>>>>>>        UBigInt ullSize
36918>>>>>>>        UChar[] ucaSalt
36919>>>>>>>        String sSalt
36919>>>>>>>        
36919>>>>>>>        Get RandomBuffer uiSaltSize to ucaSalt
36920>>>>>>>        Get Base64EncodeArr ucaSalt to sSalt
36921>>>>>>>        If (not(SizeOfString(sSalt))) Function_Return 0
36924>>>>>>>        
36924>>>>>>>        Case Begin
36924>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36926>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA256" to ullSize
36927>>>>>>>                Move True to bRequireTimeCost
36928>>>>>>>                Case Break
36929>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36932>>>>>>>                Get CNG_PBKDF2_HMAC_BufferSize "SHA512" to ullSize
36933>>>>>>>                Move True to bRequireTimeCost
36934>>>>>>>                Case Break
36935>>>>>>>            Case Else
36935>>>>>>>                Error 8710 "Invalid algorithm selected."
36936>>>>>>>>
36936>>>>>>>                Function_Return 0
36937>>>>>>>        Case End
36937>>>>>>>        
36937>>>>>>>        // calculate base64 in a non-floating-manner
36937>>>>>>>        Move (((ullSize + 3 -1) / 3) * 4) to ullSize
36938>>>>>>>        
36938>>>>>>>        Move (ullSize + SizeOfString(String(uiAlgo))) to ullSize
36939>>>>>>>        Move (ullSize + SizeOfString(sSalt)) to ullSize
36940>>>>>>>        If (bRequireTimeCost) Begin
36942>>>>>>>            Move (ullSize + SizeOfString(String(uiOptTimeCost))) to ullSize
36943>>>>>>>            Move (ullSize + 3 /*$*/) to ullSize
36944>>>>>>>        End
36944>>>>>>>>
36944>>>>>>>        Else Begin
36945>>>>>>>            Move (ullSize + 2 /*$*/) to ullSize
36946>>>>>>>        End
36946>>>>>>>>
36946>>>>>>>        
36946>>>>>>>        Function_Return ullSize
36947>>>>>>>    End_Function
36948>>>>>>>End_Class
36949>>>>>>>
36949>>>>>>>Class cPasswordHasher is a cObject
36950>>>>>>>    
36950>>>>>>>    Import_Class_Protocol cPasswordHasher_Mixin
36951>>>>>>>    
36951>>>>>>>    Procedure Construct_Object
36953>>>>>>>        Forward Send Construct_Object
36955>>>>>>>        
36955>>>>>>>        Property UInteger   peAlgorithm         C_PWH_PBKDF2_HMAC_SHA_512 
36956>>>>>>>        Property UInteger   puiSaltSize         16
36957>>>>>>>        
36957>>>>>>>        Property UInteger   puiOptTimeCost      420000
36958>>>>>>>    End_Procedure
36959>>>>>>>    
36959>>>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
36961>>>>>>>        Boolean bOk
36961>>>>>>>        UInteger uiAlgo
36961>>>>>>>        Get peAlgorithm to uiAlgo
36962>>>>>>>        
36962>>>>>>>        Case Begin
36962>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36964>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36967>>>>>>>                Get CreatePasswordHashEx uiAlgo (puiSaltSize(Self)) sPassword (&sHash) (puiOptTimeCost(Self)) to bOk
36968>>>>>>>                Case Break
36969>>>>>>>            Case Else
36969>>>>>>>                Error 8710 "Invalid algorithm selected."
36970>>>>>>>>
36970>>>>>>>                Function_Return False
36971>>>>>>>        Case End
36971>>>>>>>        
36971>>>>>>>        Function_Return bOk
36972>>>>>>>    End_Function
36973>>>>>>>    
36973>>>>>>>    Function RequiredBufferSize Returns UBigInt
36975>>>>>>>        UBigInt ullSize
36975>>>>>>>        UInteger uiAlgo
36975>>>>>>>        Get peAlgorithm to uiAlgo
36976>>>>>>>        
36976>>>>>>>        Case Begin
36976>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_256)
36978>>>>>>>            Case (uiAlgo = C_PWH_PBKDF2_HMAC_SHA_512)
36981>>>>>>>                Get RequiredBufferSizeEx uiAlgo (puiSaltSize(Self)) (puiOptTimeCost(Self)) to ullSize
36982>>>>>>>                Case Break
36983>>>>>>>            Case Else
36983>>>>>>>                Error 8710 "Invalid algorithm selected."
36984>>>>>>>>
36984>>>>>>>                Function_Return 0
36985>>>>>>>        Case End
36985>>>>>>>        
36985>>>>>>>        Function_Return ullSize
36986>>>>>>>    End_Function
36987>>>>>>>
36987>>>>>>>End_Class
