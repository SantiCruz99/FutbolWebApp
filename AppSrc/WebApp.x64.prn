39161>>>    // =====================================================
39161>>>    // CARGAR POSICIONES ASIGNADAS AL JUGADOR
39161>>>    // =====================================================
39161>>>
39161>>>    Procedure CargarPosicionesAsignadas
39164>>>
39164>>>        Integer iJugadorID
39164>>>
39164>>>        Get piJugadorID to iJugadorID
39165>>>
39165>>>        If (iJugadorID > 0) Begin
39167>>>
39167>>>            // Limpiar la estructura de consulta
39167>>>            Send Clear_All of oJugadorPosicion_DD
39168>>>
39168>>>            // Recuperar el jugador padre actual
39168>>>            Move iJugadorID to jugador.ID
39169>>>            Send Find of oJugador_DD EQ 1
39170>>>
39170>>>            If (Found) Begin
39172>>>
39172>>>                // Reconstruir la relación con el jugador actual
39172>>>                Send RebuildAllConstraints of oJugadorPosicion_DD
39173>>>
39173>>>                // Mostrar las relaciones de este jugador
39173>>>                Send FindFromTop of oListaAsignadas
39174>>>
39174>>>            End
39174>>>>
39174>>>
39174>>>        End
39174>>>>
39174>>>
39174>>>    End_Procedure
39175>>>
39175>>>
39175>>>    // =====================================================
39175>>>    // AÑADIR UNA POSICIÓN AL JUGADOR
39175>>>    // =====================================================
39175>>>
39175>>>    Procedure AgregarPosicion
39178>>>
39178>>>        Integer iJugadorID
39178>>>        Integer iPosicionID
39178>>>        Boolean bEncontrada
39178>>>        Boolean bDuplicada
39178>>>        Boolean bError
39178>>>        Boolean bTieneRegistro
39178>>>
39178>>>        Get piJugadorID to iJugadorID
39179>>>        Get piPosicionSeleccionada to iPosicionID
39180>>>
39180>>>        If (iJugadorID <= 0) Begin
39182>>>            Send UserError "No se ha seleccionado un jugador válido" "ERROR"
39183>>>            Procedure_Return
39184>>>        End
39184>>>>
39184>>>
39184>>>        If (iPosicionID <= 0) Begin
39186>>>            Send UserError "Selecciona primero una posición de la lista izquierda" "AVISO"
39187>>>            Procedure_Return
39188>>>        End
39188>>>>
39188>>>
39188>>>
39188>>>        // PASO 1: Comprobar que el jugador existe
39188>>>        Send Clear_All of oJugadorPosicion_DD
39189>>>
39189>>>        Move iJugadorID to jugador.ID
39190>>>        Send Find of oJugador_DD EQ 1
39191>>>
39191>>>        If (not(Found)) Begin
39193>>>            Send UserError "No se ha encontrado el jugador" "ERROR"
39194>>>            Procedure_Return
39195>>>        End
39195>>>>
39195>>>
39195>>>
39195>>>        // PASO 2: Reconstruir la relación del jugador actual
39195>>>        Send RebuildAllConstraints of oJugadorPosicion_DD
39196>>>
39196>>>
39196>>>        // PASO 3: Comprobar si la posición ya está asignada
39196>>>        Move False to bDuplicada
39197>>>
39197>>>        // El índice 2 comienza por JugadorID
39197>>>        Send Find of oJugadorPosicion_DD FIRST_RECORD 2
39198>>>
39198>>>        Move Found to bEncontrada
39199>>>
39199>>>        While (bEncontrada and (not(bDuplicada)))
39203>>>
39203>>>            If ((jugadorposicion.JugadorID = iJugadorID) and ;                (jugadorposicion.PosicionID = iPosicionID)) Begin
39205>>>
39205>>>                Move True to bDuplicada
39206>>>
39206>>>            End
39206>>>>
39206>>>            Else Begin
39207>>>
39207>>>                Send Find of oJugadorPosicion_DD NEXT_RECORD 2
39208>>>                Move Found to bEncontrada
39209>>>
39209>>>            End
39209>>>>
39209>>>
39209>>>        Loop
39210>>>>
39210>>>
39210>>>        If (bDuplicada) Begin
39212>>>            Send UserError "Posicion ya asignada" "ERROR"
39213>>>            Procedure_Return
39214>>>        End
39214>>>>
39214>>>
39214>>>
39214>>>        // PASO 4: Preparar la estructura independiente de inserción
39214>>>        // Limpiar todos sus DDO, incluidos sus padres
39214>>>        Send Clear_All of oJugadorPosicionSave_DD
39215>>>
39215>>>        // Comprobar que el registro de relación es nuevo
39215>>>        Get HasRecord of oJugadorPosicionSave_DD to bTieneRegistro
39216>>>
39216>>>        If (bTieneRegistro) Begin
39218>>>            Send UserError "No se ha podido preparar un registro nuevo" "ERROR"
39219>>>            Procedure_Return
39220>>>        End
39220>>>>
39220>>>
39220>>>
39220>>>        // PASO 5: Recuperar el jugador en la estructura de inserción
39220>>>        Move iJugadorID to jugador.ID
39221>>>        Send Find of oJugadorSave_DD EQ 1
39222>>>
39222>>>        If (not(Found)) Begin
39224>>>            Send UserError "No se ha encontrado el jugador para guardar la relación" "ERROR"
39225>>>            Procedure_Return
39226>>>        End
39226>>>>
39226>>>
39226>>>
39226>>>        // PASO 6: Recuperar la posición en la estructura de inserción
39226>>>        Move iPosicionID to posicion.ID
39227>>>        Send Find of oPosicionSave_DD EQ 1
39228>>>
39228>>>        If (not(Found)) Begin
39230>>>            Send UserError "No se ha encontrado la posición para guardar la relación" "ERROR"
39231>>>            Procedure_Return
39232>>>        End
39232>>>>
39232>>>
39232>>>
39232>>>        // PASO 7: Asignar los campos de la nueva relación
39232>>>        // El ID se genera automáticamente en MySQL
39232>>>
39232>>>        Set Field_Changed_Value of oJugadorPosicionSave_DD ;            Field jugadorposicion.JugadorID to iJugadorID
39233>>>
39233>>>        Set Field_Changed_Value of oJugadorPosicionSave_DD ;            Field jugadorposicion.PosicionID to iPosicionID
39234>>>
39234>>>
39234>>>        // PASO 8: Comprobar que el DDO sigue siendo nuevo
39234>>>        Get HasRecord of oJugadorPosicionSave_DD to bTieneRegistro
39235>>>
39235>>>        If (bTieneRegistro) Begin
39237>>>            Send UserError "El DDO de inserción contiene un registro anterior. Se cancela el guardado." "ERROR"
39238>>>            Procedure_Return
39239>>>        End
39239>>>>
39239>>>
39239>>>
39239>>>        // PASO 9: Validar los campos obligatorios
39239>>>        Get Request_Validate of oJugadorPosicionSave_DD to bError
39240>>>
39240>>>        If (bError) Begin
39242>>>            Send UserError "No se pueden validar JugadorID y PosicionID" "ERROR"
39243>>>            Procedure_Return
39244>>>        End
39244>>>>
39244>>>
39244>>>
39244>>>        // PASO 10: Insertar una NUEVA fila en MySQL
39244>>>        Send Request_Save of oJugadorPosicionSave_DD
39245>>>
39245>>>        Move (Err) to bError
39246>>>
39246>>>        If (bError) Begin
39248>>>            Send UserError "No se pudo insertar la nueva posición del jugador" "ERROR"
39249>>>            Procedure_Return
39250>>>        End
39250>>>>
39250>>>
39250>>>
39250>>>        // Limpiar las selecciones
39250>>>        Set piPosicionSeleccionada to 0
39251>>>        Set piJugadorPosicionSeleccionada to 0
39252>>>        Set piPosicionDerechaSeleccionada to 0
39253>>>
39253>>>
39253>>>        // Actualizar las posiciones asignadas
39253>>>        Send CargarPosicionesAsignadas
39254>>>
39254>>>        // Mantener visible la lista completa de posiciones
39254>>>        Send CargarPosicionesDisponibles
39255>>>
39255>>>    End_Procedure
