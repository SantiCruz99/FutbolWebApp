37748>>>        Boolean bHasRecord
37748>>>        Integer iRecord
37748>>>
37748>>>        Get GetNavigateData to NavigateData
37749>>>        Get Current_Record of oEntrenador_DD to iRecord
37750>>>        Move (iRecord <> 0) to bHasRecord
37751>>>
37751>>>        // Ocultamos todos los botones por defecto y mostramos los necesarios según el estado
37751>>>        WebSet pbRender of oEditBtn to False
37752>>>        WebSet pbRender of oSaveBtn to False
37753>>>        WebSet pbRender of oCancelChangesBtn to False
37754>>>        WebSet pbRender of oDeleteBtn to False
