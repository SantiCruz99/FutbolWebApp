39209>>>    // =====================================================
39209>>>    // CARGAR POSICIONES ASIGNADAS AL JUGADOR
39209>>>    // =====================================================
39209>>>
39209>>>    Procedure CargarPosicionesAsignadas
39212>>>
39212>>>        Integer iJugadorID
39212>>>
39212>>>        Get piJugadorID to iJugadorID
39213>>>
39213>>>        If (iJugadorID > 0) Begin
39215>>>
39215>>>            // Limpiar la estructura de consulta
39215>>>            Send Clear_All of oJugadorPosicion_DD
39216>>>
39216>>>            // Recuperar el jugador padre actual
39216>>>            Move iJugadorID to jugador.ID
39217>>>            Send Find of oJugador_DD EQ 1
39218>>>
39218>>>            If (Found) Begin
39220>>>
39220>>>                // Reconstruir la relación con el jugador actual
39220>>>                Send RebuildAllConstraints of oJugadorPosicion_DD
39221>>>
39221>>>                // Mostrar las relaciones de este jugador
39221>>>                Send FindFromTop of oListaAsignadas
39222>>>
39222>>>            End
39222>>>>
39222>>>
39222>>>        End
39222>>>>
39222>>>
39222>>>    End_Procedure
39223>>>
39223>>>
39223>>>    // =====================================================
39223>>>    // AÑADIR UNA POSICIÓN AL JUGADOR
39223>>>    // =====================================================
39223>>>
39223>>>    Procedure AgregarPosicion
39226>>>
39226>>>        Integer iJugadorID
39226>>>        Integer iPosicionID
39226>>>        Boolean bEncontrada
39226>>>        Boolean bDuplicada
39226>>>        Boolean bError
39226>>>        Boolean bTieneRegistro
39226>>>
39226>>>        Get piJugadorID to iJugadorID
39227>>>        Get piPosicionSeleccionada to iPosicionID
39228>>>
39228>>>        If (iJugadorID <= 0) Begin
39230>>>            Send UserError "No se ha seleccionado un jugador válido" "ERROR"
39231>>>            Procedure_Return
39232>>>        End
39232>>>>
39232>>>
39232>>>        If (iPosicionID <= 0) Begin
39234>>>            Send UserError "Selecciona primero una posición de la lista izquierda" "AVISO"
39235>>>            Procedure_Return
39236>>>        End
39236>>>>
39236>>>
39236>>>
39236>>>        // PASO 1: Comprobar que el jugador existe
39236>>>        Send Clear_All of oJugadorPosicion_DD
39237>>>
39237>>>        Move iJugadorID to jugador.ID
39238>>>        Send Find of oJugador_DD EQ 1
39239>>>
39239>>>        If (not(Found)) Begin
39241>>>            Send UserError "No se ha encontrado el jugador" "ERROR"
39242>>>            Procedure_Return
39243>>>        End
39243>>>>
39243>>>
39243>>>
39243>>>        // PASO 2: Reconstruir la relación del jugador actual
39243>>>        Send RebuildAllConstraints of oJugadorPosicion_DD
39244>>>
39244>>>
39244>>>        // PASO 3: Comprobar si la posición ya está asignada
39244>>>        Move False to bDuplicada
39245>>>
39245>>>        // El índice 2 comienza por JugadorID
39245>>>        Send Find of oJugadorPosicion_DD FIRST_RECORD 2
39246>>>
39246>>>        Move Found to bEncontrada
39247>>>
39247>>>        While (bEncontrada and (not(bDuplicada)))
39251>>>
39251>>>            If ((jugadorposicion.JugadorID = iJugadorID) and ;                (jugadorposicion.PosicionID = iPosicionID)) Begin
39253>>>
39253>>>                Move True to bDuplicada
39254>>>
39254>>>            End
39254>>>>
39254>>>            Else Begin
39255>>>
39255>>>                Send Find of oJugadorPosicion_DD NEXT_RECORD 2
39256>>>                Move Found to bEncontrada
39257>>>
39257>>>            End
39257>>>>
39257>>>
39257>>>        Loop
39258>>>>
39258>>>
39258>>>        If (bDuplicada) Begin
39260>>>            Send UserError "Posicion ya asignada" "ERROR"
39261>>>            Procedure_Return
39262>>>        End
39262>>>>
39262>>>
39262>>>
39262>>>        // PASO 4: Preparar la estructura independiente de inserción
39262>>>        // Limpiar todos sus DDO, incluidos sus padres
39262>>>        Send Clear_All of oJugadorPosicionSave_DD
39263>>>
39263>>>        // Comprobar que el registro de relación es nuevo
39263>>>        Get HasRecord of oJugadorPosicionSave_DD to bTieneRegistro
39264>>>
39264>>>        If (bTieneRegistro) Begin
39266>>>            Send UserError "No se ha podido preparar un registro nuevo" "ERROR"
39267>>>            Procedure_Return
39268>>>        End
39268>>>>
39268>>>
39268>>>
39268>>>        // PASO 5: Recuperar el jugador en la estructura de inserción
39268>>>        Move iJugadorID to jugador.ID
39269>>>        Send Find of oJugadorSave_DD EQ 1
39270>>>
39270>>>        If (not(Found)) Begin
39272>>>            Send UserError "No se ha encontrado el jugador para guardar la relación" "ERROR"
39273>>>            Procedure_Return
39274>>>        End
39274>>>>
39274>>>
39274>>>
39274>>>        // PASO 6: Recuperar la posición en la estructura de inserción
39274>>>        Move iPosicionID to posicion.ID
39275>>>        Send Find of oPosicionSave_DD EQ 1
39276>>>
39276>>>        If (not(Found)) Begin
39278>>>            Send UserError "No se ha encontrado la posición para guardar la relación" "ERROR"
39279>>>            Procedure_Return
39280>>>        End
39280>>>>
39280>>>
39280>>>
39280>>>        // PASO 7: Asignar los campos de la nueva relación
39280>>>        // El ID se genera automáticamente en MySQL
39280>>>
39280>>>        Set Field_Changed_Value of oJugadorPosicionSave_DD ;            Field jugadorposicion.JugadorID to iJugadorID
39281>>>
39281>>>        Set Field_Changed_Value of oJugadorPosicionSave_DD ;            Field jugadorposicion.PosicionID to iPosicionID
39282>>>
39282>>>
39282>>>        // PASO 8: Comprobar que el DDO sigue siendo nuevo
39282>>>        Get HasRecord of oJugadorPosicionSave_DD to bTieneRegistro
39283>>>
39283>>>        If (bTieneRegistro) Begin
39285>>>            Send UserError "El DDO de inserción contiene un registro anterior. Se cancela el guardado." "ERROR"
39286>>>            Procedure_Return
39287>>>        End
39287>>>>
39287>>>
39287>>>
39287>>>        // PASO 9: Validar los campos obligatorios
39287>>>        Get Request_Validate of oJugadorPosicionSave_DD to bError
39288>>>
39288>>>        If (bError) Begin
39290>>>            Send UserError "No se pueden validar JugadorID y PosicionID" "ERROR"
39291>>>            Procedure_Return
39292>>>        End
39292>>>>
39292>>>
39292>>>
39292>>>        // PASO 10: Insertar una NUEVA fila en MySQL
39292>>>        Send Request_Save of oJugadorPosicionSave_DD
39293>>>
39293>>>        Move (Err) to bError
39294>>>
39294>>>        If (bError) Begin
39296>>>            Send UserError "No se pudo insertar la nueva posición del jugador" "ERROR"
39297>>>            Procedure_Return
39298>>>        End
39298>>>>
39298>>>
39298>>>
39298>>>        // Limpiar las selecciones
39298>>>        Set piPosicionSeleccionada to 0
39299>>>        Set piJugadorPosicionSeleccionada to 0
39300>>>        Set piPosicionDerechaSeleccionada to 0
39301>>>
39301>>>
39301>>>        // Actualizar las posiciones asignadas
39301>>>        Send CargarPosicionesAsignadas
39302>>>
39302>>>        // Mantener visible la lista completa de posiciones
39302>>>        Send CargarPosicionesDisponibles
39303>>>
39303>>>    End_Procedure
39304>>>
39304>>>
39304>>>    // =====================================================
39304>>>    // QUITAR UNA POSICIÓN DEL JUGADOR
39304>>>    // =====================================================
39304>>>
39304>>>    Procedure QuitarPosicion
39307>>>
39307>>>        Integer iJugadorID
39307>>>        Integer iRelacionID
39307>>>        Integer iPosicionID
39307>>>        Boolean bError
39307>>>
39307>>>        Get piJugadorID to iJugadorID
39308>>>        Get piJugadorPosicionSeleccionada to iRelacionID
39309>>>        Get piPosicionDerechaSeleccionada to iPosicionID
39310>>>
39310>>>        // Comprobar que se ha seleccionado una asignación en la derecha
39310>>>        If (iRelacionID <= 0) Begin
39312>>>            Send UserError "Selecciona primero la posición que deseas quitar en la lista derecha" "AVISO"
39313>>>            Procedure_Return
39314>>>        End
39314>>>>
39314>>>
39314>>>        If (iJugadorID <= 0) Begin
39316>>>            Send UserError "No se ha seleccionado un jugador válido" "ERROR"
39317>>>            Procedure_Return
39318>>>        End
39318>>>>
39318>>>
39318>>>
39318>>>        // Recuperar el jugador padre actual
39318>>>        Send Clear_All of oJugadorPosicion_DD
39319>>>
39319>>>        Move iJugadorID to jugador.ID
39320>>>        Send Find of oJugador_DD EQ 1
39321>>>
39321>>>        If (not(Found)) Begin
39323>>>            Send UserError "No se ha encontrado el jugador" "ERROR"
39324>>>            Procedure_Return
39325>>>        End
39325>>>>
39325>>>
39325>>>
39325>>>        // Reconstruir el filtro correspondiente al jugador actual
39325>>>        Send RebuildAllConstraints of oJugadorPosicion_DD
39326>>>
39326>>>
39326>>>        // Recuperar solamente la relación seleccionada
39326>>>        Move iRelacionID to jugadorposicion.ID
39327>>>        Send Find of oJugadorPosicion_DD EQ 1
39328>>>
39328>>>        If (not(Found)) Begin
39330>>>            Send UserError "La asignación seleccionada ya no existe para este jugador" "ERROR"
39331>>>            Procedure_Return
39332>>>        End
39332>>>>
39332>>>
39332>>>
39332>>>        // Comprobar que la relación pertenece al jugador actual
39332>>>        If (jugadorposicion.JugadorID <> iJugadorID) Begin
39334>>>            Send UserError "La posición seleccionada no pertenece a este jugador" "ERROR"
39335>>>            Procedure_Return
39336>>>        End
39336>>>>
39336>>>
39336>>>        If (jugadorposicion.PosicionID <> iPosicionID) Begin
39338>>>            Send UserError "La asignación seleccionada ha cambiado. Vuelve a seleccionarla" "ERROR"
39339>>>            Procedure_Return
39340>>>        End
39340>>>>
39340>>>
39340>>>
39340>>>        // Eliminar únicamente la relación jugador-posicion seleccionada
39340>>>        Send Request_Delete of oJugadorPosicion_DD
39341>>>
39341>>>        Move (Err) to bError
39342>>>
39342>>>        If (bError) Begin
39344>>>            Send UserError "No se pudo quitar la posición del jugador" "ERROR"
39345>>>            Procedure_Return
39346>>>        End
39346>>>>
39346>>>
39346>>>
39346>>>        // Limpiar las selecciones
39346>>>        Set piJugadorPosicionSeleccionada to 0
39347>>>        Set piPosicionDerechaSeleccionada to 0
39348>>>        Set piPosicionSeleccionada to 0
39349>>>
39349>>>
39349>>>        // Actualizar las posiciones asignadas
39349>>>        Send CargarPosicionesAsignadas
39350>>>
39350>>>        // Mantener la lista izquierda completa
39350>>>        Send CargarPosicionesDisponibles
39351>>>
39351>>>    End_Procedure
39352>>>
