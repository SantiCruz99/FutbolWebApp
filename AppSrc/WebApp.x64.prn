37639>>>>>Procedure Backout
37641>>>>>    Forward Send Backout
37643>>>>>
37643>>>>>    // Solo modificar el contador cuando se está guardando
37643>>>>>    // o eliminando un equipo desde su propio DDO.
37643>>>>>    If (Operation_Origin = Self) Begin
37645>>>>>        Integer iNumEquipos
37645>>>>>
37645>>>>>        Move liga.Equipos to iNumEquipos
37646>>>>>
37646>>>>>        If (iNumEquipos > 0) Begin
37648>>>>>            Decrement iNumEquipos
37649>>>>>            Move iNumEquipos to liga.Equipos
37650>>>>>        End
37650>>>>>>
37650>>>>>        Else Begin
37651>>>>>            Send UserError "No hay equipos para quitar" "ERROR"
37652>>>>>        End
37652>>>>>>
37652>>>>>    End
37652>>>>>>
37652>>>>>End_Procedure
37653>>>>>
37653>>>>>
37653>>>>>// 2
37653>>>>>Procedure Update
37655>>>>>    Forward Send Update
37657>>>>>
37657>>>>>    // No contar como equipo una operación iniciada
37657>>>>>    // desde otro DDO, por ejemplo entrenador.
37657>>>>>    If (Operation_Origin = Self) Begin
37659>>>>>        Integer iNumEquipos iMaxEquipos
37659>>>>>
37659>>>>>        Move liga.Equipos to iNumEquipos
37660>>>>>        Move liga.EquiposMax to iMaxEquipos
37661>>>>>
37661>>>>>        If (iNumEquipos < iMaxEquipos) Begin
37663>>>>>            Increment iNumEquipos
37664>>>>>            Move iNumEquipos to liga.Equipos
37665>>>>>        End
