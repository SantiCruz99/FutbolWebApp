37741>>>    Procedure SetActionButtons
37744>>>        tWebNavigateData NavigateData
37744>>>        tWebNavigateData NavigateData
37744>>>        Boolean bHasRecord
37744>>>        Integer iRecord
37744>>>
37744>>>        Get GetNavigateData to NavigateData
37745>>>        Get Current_Record of oEntrenador_DD to iRecord
37746>>>        Move (iRecord <> 0) to bHasRecord
37747>>>
37747>>>        // Ocultamos todos los botones por defecto y mostramos los necesarios según el estado
37747>>>        WebSet pbRender of oEditBtn to False
37748>>>        WebSet pbRender of oSaveBtn to False
37749>>>        WebSet pbRender of oCancelChangesBtn to False
37750>>>        WebSet pbRender of oDeleteBtn to False
37751>>>
37751>>>        If (NavigateData.bReadOnly) Begin
37753>>>            WebSet pbRender of oEditBtn to True
37754>>>        End
37754>>>>
37754>>>        Else Begin
37755>>>            WebSet pbRender of oSaveBtn to True
37756>>>            WebSet pbRender of oCancelChangesBtn to True
37757>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37758>>>        End
37758>>>>
37758>>>    End_Procedure
37759>>>
37759>>>    Procedure OnNavigateForward tWebNavigateData NavigateData
37762>>>        String sRowId
37762>>>        RowID riEntrenador
37762>>>
37762>>>        Forward Send OnNavigateForward NavigateData
37764>>>
37764>>>        // Recuperamos el RowId enviado desde la lista de selección y buscamos el registro
37764>>>        Get NamedValueGet NavigateData.NamedValues "EntrenadorRowId" to sRowId
37765>>>        If (sRowId <> "") Begin
37767>>>            Move (DeserializeRowId(sRowId)) to riEntrenador
37768>>>            Send FindByRowId of oEntrenador_DD entrenador.File_Number riEntrenador
37769>>>            Send Request_Assign of oEntrenador_DD
37770>>>        End
37770>>>>
37770>>>
37770>>>        Send ChangeEditMode False
37771>>>        Send SetActionButtons
37772>>>    End_Procedure
