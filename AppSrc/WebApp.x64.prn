39166>>>    // =====================================================
39166>>>    // CARGAR POSICIONES ASIGNADAS AL JUGADOR
39166>>>    // =====================================================
39166>>>
39166>>>    Procedure CargarPosicionesAsignadas
39169>>>
39169>>>        Integer iJugadorID
39169>>>
39169>>>        Get piJugadorID to iJugadorID
39170>>>
39170>>>        If (iJugadorID > 0) Begin
39172>>>
39172>>>            // Limpiar la estructura de consulta
39172>>>            Send Clear_All of oJugadorPosicion_DD
39173>>>
39173>>>            // Recuperar el jugador padre actual
39173>>>            Move iJugadorID to jugador.ID
39174>>>            Send Find of oJugador_DD EQ 1
39175>>>
39175>>>            If (Found) Begin
39177>>>
39177>>>                // Reconstruir la relación con el jugador actual
39177>>>                Send RebuildAllConstraints of oJugadorPosicion_DD
39178>>>
39178>>>                // Mostrar las relaciones de este jugador
39178>>>                Send FindFromTop of oListaAsignadas
39179>>>
39179>>>            End
39179>>>>
39179>>>
39179>>>        End
39179>>>>
39179>>>
39179>>>    End_Procedure
