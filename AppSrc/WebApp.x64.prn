39261>>>    // =====================================================
39261>>>    // QUITAR UNA POSICIÓN DEL JUGADOR
39261>>>    // =====================================================
39261>>>
39261>>>    Procedure QuitarPosicion
39264>>>
39264>>>        Integer iJugadorID
39264>>>        Integer iRelacionID
39264>>>        Integer iPosicionID
39264>>>        Boolean bError
39264>>>
39264>>>        Get piJugadorID to iJugadorID
39265>>>        Get piJugadorPosicionSeleccionada to iRelacionID
39266>>>        Get piPosicionDerechaSeleccionada to iPosicionID
39267>>>
39267>>>        // Comprobar que se ha seleccionado una asignación en la derecha
39267>>>        If (iRelacionID <= 0) Begin
39269>>>            Send UserError "Selecciona primero la posición que deseas quitar en la lista derecha" "AVISO"
39270>>>            Procedure_Return
39271>>>        End
39271>>>>
39271>>>
39271>>>        If (iJugadorID <= 0) Begin
39273>>>            Send UserError "No se ha seleccionado un jugador válido" "ERROR"
39274>>>            Procedure_Return
39275>>>        End
39275>>>>
39275>>>
39275>>>
39275>>>        // Recuperar el jugador padre actual
39275>>>        Send Clear_All of oJugadorPosicion_DD
39276>>>
39276>>>        Move iJugadorID to jugador.ID
39277>>>        Send Find of oJugador_DD EQ 1
39278>>>
39278>>>        If (not(Found)) Begin
39280>>>            Send UserError "No se ha encontrado el jugador" "ERROR"
39281>>>            Procedure_Return
39282>>>        End
39282>>>>
39282>>>
39282>>>
39282>>>        // Reconstruir el filtro correspondiente al jugador actual
39282>>>        Send RebuildAllConstraints of oJugadorPosicion_DD
39283>>>
39283>>>
39283>>>        // Recuperar solamente la relación seleccionada
39283>>>        Move iRelacionID to jugadorposicion.ID
39284>>>        Send Find of oJugadorPosicion_DD EQ 1
39285>>>
39285>>>        If (not(Found)) Begin
39287>>>            Send UserError "La asignación seleccionada ya no existe para este jugador" "ERROR"
39288>>>            Procedure_Return
39289>>>        End
39289>>>>
39289>>>
39289>>>
39289>>>        // Comprobar que la relación pertenece al jugador actual
39289>>>        If (jugadorposicion.JugadorID <> iJugadorID) Begin
39291>>>            Send UserError "La posición seleccionada no pertenece a este jugador" "ERROR"
39292>>>            Procedure_Return
39293>>>        End
39293>>>>
39293>>>
39293>>>        If (jugadorposicion.PosicionID <> iPosicionID) Begin
39295>>>            Send UserError "La asignación seleccionada ha cambiado. Vuelve a seleccionarla" "ERROR"
39296>>>            Procedure_Return
39297>>>        End
39297>>>>
39297>>>
39297>>>
39297>>>        // Eliminar únicamente la relación jugador-posicion seleccionada
39297>>>        Send Request_Delete of oJugadorPosicion_DD
39298>>>
39298>>>        Move (Err) to bError
39299>>>
39299>>>        If (bError) Begin
39301>>>            Send UserError "No se pudo quitar la posición del jugador" "ERROR"
39302>>>            Procedure_Return
39303>>>        End
39303>>>>
39303>>>
39303>>>
39303>>>        // Limpiar las selecciones
39303>>>        Set piJugadorPosicionSeleccionada to 0
39304>>>        Set piPosicionDerechaSeleccionada to 0
39305>>>        Set piPosicionSeleccionada to 0
39306>>>
39306>>>
39306>>>        // Actualizar las posiciones asignadas
39306>>>        Send CargarPosicionesAsignadas
39307>>>
39307>>>        // Mantener la lista izquierda completa
39307>>>        Send CargarPosicionesDisponibles
39308>>>
39308>>>    End_Procedure
