38177>>>    Procedure SetActionButtons
38180>>>        tWebNavigateData NavigateData
38180>>>        tWebNavigateData NavigateData
38180>>>        Boolean bHasRecord
38180>>>        Handle hoDD
38180>>>
38180>>>        Get Server to hoDD
38181>>>        Get GetNavigateData to NavigateData
38182>>>        Get HasRecord of hoDD to bHasRecord
38183>>>
38183>>>        // Ocultamos todos los botones por defecto y mostramos los necesarios según el estado
38183>>>        WebSet pbRender of oEditBtn to False
38184>>>        WebSet pbRender of oSaveBtn to False
38185>>>        WebSet pbRender of oCancelChangesBtn to False
38186>>>        WebSet pbRender of oDeleteBtn to False
38187>>>
38187>>>        If (NavigateData.bReadOnly) Begin
38189>>>            WebSet pbRender of oEditBtn to True
38190>>>        End
38190>>>>
38190>>>        Else Begin
