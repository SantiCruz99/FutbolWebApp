36691>>>>>>>    //
36691>>>>>>>    //  Converts the given time to an string that can be saved in the database.
36691>>>>>>>    //
36691>>>>>>>    //  Params:
36691>>>>>>>    //      dtTime  Time to convert
36691>>>>>>>    //  Returns:
36691>>>>>>>    //      String with "HH:MM:SS" format
36691>>>>>>>    //
36691>>>>>>>    Function TimeToString DateTime dtTime Returns String
36693>>>>>>>        String sHours sMinutes sSeconds
36693>>>>>>>        
36693>>>>>>>        //  Extract parts
36693>>>>>>>        Move (String(DateGetHour(dtTime))) to sHours
36694>>>>>>>        Move (String(DateGetMinute(dtTime))) to sMinutes
36695>>>>>>>        Move (String(DateGetSecond(dtTime))) to sSeconds
36696>>>>>>>        
36696>>>>>>>        //  Fill out with 0
36696>>>>>>>        If (Length(sHours) = 1) ;            Move ("0" + sHours) to sHours
36699>>>>>>>        If (Length(sMinutes) = 1) ;            Move ("0" + sMinutes) to sMinutes
36702>>>>>>>        If (Length(sSeconds) = 1) ;            Move ("0" + sSeconds) to sSeconds
36705>>>>>>>        
36705>>>>>>>        Function_Return (sHours + ":" + sMinutes + ":" + sSeconds)
36706>>>>>>>    End_Function
36707>>>>>>>    
36707>>>>>>>    //
36707>>>>>>>    //  Sets the time of the datetime variable to the time in the string.
36707>>>>>>>    //
36707>>>>>>>    //  Params:
36707>>>>>>>    //      dtTime  Datetime variable to add time to
36707>>>>>>>    //      sTimeString String with time in the format "HH:MM:SS"
36707>>>>>>>    //  Returns:
36707>>>>>>>    //      dtDateTime with the loaded time
36707>>>>>>>    //
36707>>>>>>>    Function StringToTime DateTime dtTime String sTimeString Returns DateTime
36709>>>>>>>        String sHours sMinutes sSeconds
36709>>>>>>>        
36709>>>>>>>        //  Extract parts
36709>>>>>>>        Move (Mid(sTimeString, 2, 1)) to sHours
36710>>>>>>>        Move (Mid(sTimeString, 2, 4)) to sMinutes
36711>>>>>>>        Move (Mid(sTimeString, 2, 7)) to sSeconds
36712>>>>>>>        
36712>>>>>>>        //  Set to DateTime
36712>>>>>>>        Move (DateSetHour(dtTime, (Integer(sHours)))) to dtTime
36713>>>>>>>        Move (DateSetMinute(dtTime, (Integer(sMinutes)))) to dtTime
36714>>>>>>>        Move (DateSetSecond(dtTime, (Integer(sSeconds)))) to dtTime
36715>>>>>>>        
36715>>>>>>>        Function_Return dtTime
36716>>>>>>>    End_Function
