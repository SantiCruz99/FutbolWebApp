37382>>>    Procedure DoLogin
37385>>>        String sLoginName sPassword sPrevStateHash
37385>>>        Boolean bResult
37385>>>        
37385>>>        WebGet psValue of oLoginName to sLoginName
37386>>>        WebGet psValue of oPassword to sPassword
37387>>>        
37387>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37388>>>        
37388>>>        If (bResult) Begin
37390>>>            Send Hide of oLogin
37391>>>            Send ShowHeader of ghoWebApp
37392>>>            WebSet psCSSClass of ghoWebApp to ""
37393>>>            
37393>>>            WebGet psPrevStateHash to sPrevStateHash
37394>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37395>>>            
37395>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37395>>>            WebSet psValue of oLoginName to ""
37396>>>            WebSet psValue of oPassword  to ""
37397>>>            WebSet pbVisible of oWarning to False
37398>>>        End
37398>>>>
37398>>>        Else Begin
37399>>>            WebSet pbVisible of oWarning to True
37400>>>        End
37400>>>>
37400>>>    End_Procedure
37401>>>    
37401>>>    Procedure OnSubmit
37404>>>        Send DoLogin
37405>>>    End_Procedure
37406>>>    
37406>>>    Procedure OnLoad
37409>>>        String sPrevStateHash sView
37409>>>        
37409>>>        Forward Send OnLoad
37411>>>        
37411>>>        //  Store the current state so we can go back to that later (only if it points to a different view)
37411>>>        Get StateHash of ghoWebApp to sPrevStateHash
37412>>>        Send ParseViewStateHash sPrevStateHash (&sView)
37413>>>        If (Lowercase(sView) <> Lowercase(psStateViewName(Self))) Begin
37415>>>            WebSet psPrevStateHash to sPrevStateHash
37416>>>        End
37416>>>>
37416>>>        
37416>>>    End_Procedure
