37774>>>    Procedure SetActionButtons
37777>>>        tWebNavigateData NavigateData
37777>>>        tWebNavigateData NavigateData
37777>>>        Boolean bHasRecord
37777>>>        Integer iRecord
37777>>>
37777>>>        Get GetNavigateData to NavigateData
37778>>>        Get Current_Record of oEntrenador_DD to iRecord
37779>>>        Move (iRecord <> 0) to bHasRecord
37780>>>
37780>>>        // Ocultamos todos los botones por defecto y mostramos los necesarios según el estado
37780>>>        WebSet pbRender of oEditBtn to False
37781>>>        WebSet pbRender of oSaveBtn to False
37782>>>        WebSet pbRender of oCancelChangesBtn to False
37783>>>        WebSet pbRender of oDeleteBtn to False
37784>>>
37784>>>        If (NavigateData.bReadOnly) Begin
37786>>>            WebSet pbRender of oEditBtn to True
37787>>>        End
37787>>>>
37787>>>        Else Begin
37788>>>            WebSet pbRender of oSaveBtn to True
37789>>>            WebSet pbRender of oCancelChangesBtn to True
37790>>>            WebSet pbRender of oDeleteBtn to bHasRecord
37791>>>        End
37791>>>>
37791>>>    End_Procedure
37792>>>
37792>>>    Procedure OnNavigateForward tWebNavigateData NavigateData
37795>>>        String sRowId
37795>>>        RowID riEntrenador
37795>>>
37795>>>        Forward Send OnNavigateForward NavigateData
37797>>>
37797>>>        // Recuperamos el RowId enviado desde la lista de selección y buscamos el registro
37797>>>        Get NamedValueGet NavigateData.NamedValues "EntrenadorRowId" to sRowId
37798>>>        If (sRowId <> "") Begin
37800>>>            Move (DeserializeRowId(sRowId)) to riEntrenador
37801>>>            Send FindByRowId of oEntrenador_DD entrenador.File_Number riEntrenador
37802>>>            Send Request_Assign of oEntrenador_DD
37803>>>        End
37803>>>>
37803>>>
37803>>>        Send ChangeEditMode False
37804>>>        Send SetActionButtons
37805>>>    End_Procedure
