39180>>>
39180>>>    // =====================================================
39180>>>    // AÑADIR UNA POSICIÓN AL JUGADOR
39180>>>    // =====================================================
39180>>>
39180>>>    Procedure AgregarPosicion
39183>>>
39183>>>        Integer iJugadorID
39183>>>        Integer iPosicionID
39183>>>        Boolean bEncontrada
39183>>>        Boolean bDuplicada
39183>>>        Boolean bError
39183>>>        Boolean bTieneRegistro
39183>>>
39183>>>        Get piJugadorID to iJugadorID
39184>>>        Get piPosicionSeleccionada to iPosicionID
39185>>>
39185>>>        If (iJugadorID <= 0) Begin
39187>>>            Send UserError "No se ha seleccionado un jugador válido" "ERROR"
39188>>>            Procedure_Return
39189>>>        End
39189>>>>
39189>>>
39189>>>        If (iPosicionID <= 0) Begin
39191>>>            Send UserError "Selecciona primero una posición de la lista izquierda" "AVISO"
39192>>>            Procedure_Return
39193>>>        End
39193>>>>
39193>>>
39193>>>
39193>>>        // PASO 1: Comprobar que el jugador existe
39193>>>        Send Clear_All of oJugadorPosicion_DD
39194>>>
39194>>>        Move iJugadorID to jugador.ID
39195>>>        Send Find of oJugador_DD EQ 1
39196>>>
39196>>>        If (not(Found)) Begin
39198>>>            Send UserError "No se ha encontrado el jugador" "ERROR"
39199>>>            Procedure_Return
39200>>>        End
39200>>>>
39200>>>
39200>>>
39200>>>        // PASO 2: Reconstruir la relación del jugador actual
39200>>>        Send RebuildAllConstraints of oJugadorPosicion_DD
39201>>>
39201>>>
39201>>>        // PASO 3: Comprobar si la posición ya está asignada
39201>>>        Move False to bDuplicada
39202>>>
39202>>>        // El índice 2 comienza por JugadorID
39202>>>        Send Find of oJugadorPosicion_DD FIRST_RECORD 2
39203>>>
39203>>>        Move Found to bEncontrada
39204>>>
39204>>>        While (bEncontrada and (not(bDuplicada)))
39208>>>
39208>>>            If ((jugadorposicion.JugadorID = iJugadorID) and ;                (jugadorposicion.PosicionID = iPosicionID)) Begin
39210>>>
