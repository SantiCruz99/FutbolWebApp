39211>>>
39211>>>            End
39211>>>>
39211>>>            Else Begin
39212>>>
39212>>>                Send Find of oJugadorPosicion_DD NEXT_RECORD 2
39213>>>                Move Found to bEncontrada
39214>>>
39214>>>            End
39214>>>>
39214>>>
39214>>>        Loop
39215>>>>
39215>>>
39215>>>        If (bDuplicada) Begin
39217>>>            Send UserError "Posicion ya asignada" "ERROR"
39218>>>            Procedure_Return
39219>>>        End
39219>>>>
39219>>>
39219>>>
39219>>>        // PASO 4: Preparar la estructura independiente de inserción
39219>>>        // Limpiar todos sus DDO, incluidos sus padres
39219>>>        Send Clear_All of oJugadorPosicionSave_DD
39220>>>
