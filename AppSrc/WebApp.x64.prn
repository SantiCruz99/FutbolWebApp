39236>>>            Procedure_Return
39237>>>        End
39237>>>>
39237>>>
39237>>>
39237>>>        // PASO 7: Asignar los campos de la nueva relación
39237>>>        // El ID se genera automáticamente en MySQL
39237>>>
39237>>>        Set Field_Changed_Value of oJugadorPosicionSave_DD ;            Field jugadorposicion.JugadorID to iJugadorID
39238>>>
39238>>>        Set Field_Changed_Value of oJugadorPosicionSave_DD ;            Field jugadorposicion.PosicionID to iPosicionID
39239>>>
39239>>>
