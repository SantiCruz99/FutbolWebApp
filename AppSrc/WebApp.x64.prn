37399>>>    Procedure DoLogin
37402>>>        String sLoginName sPassword sPrevStateHash
37402>>>        Boolean bResult
37402>>>        
37402>>>        WebGet psValue of oLoginName to sLoginName
37403>>>        WebGet psValue of oPassword to sPassword
37404>>>        
37404>>>        Get UserLogin of ghoWebSessionManager sLoginName sPassword to bResult
37405>>>        
37405>>>        If (bResult) Begin
37407>>>            Send Hide of oLogin
37408>>>            Send ShowHeader of ghoWebApp
37409>>>            WebSet psCSSClass of ghoWebApp to ""
37410>>>            
37410>>>            WebGet psPrevStateHash to sPrevStateHash
37411>>>            Send NavigateToStateHash of ghoWebApp sPrevStateHash True
37412>>>            
37412>>>            // clear the login values. we don't want to return the login id & password as synchronized properties....
37412>>>            WebSet psValue of oLoginName to ""
37413>>>            WebSet psValue of oPassword  to ""
37414>>>            WebSet pbVisible of oWarning to False
37415>>>        End
37415>>>>
37415>>>        Else Begin
37416>>>            WebSet pbVisible of oWarning to True
37417>>>        End
37417>>>>
37417>>>    End_Procedure
