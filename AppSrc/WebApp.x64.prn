38301>>>    Procedure SetActionButtons
38304>>>        tWebNavigateData NavigateData
38304>>>        tWebNavigateData NavigateData
38304>>>        Boolean bHasRecord
38304>>>        Handle hoDD
38304>>>
38304>>>        Get Server to hoDD
38305>>>        Get GetNavigateData to NavigateData
38306>>>        Get HasRecord of hoDD to bHasRecord
38307>>>
38307>>>        // Ocultamos todos los botones por defecto y mostramos los necesarios según el estado
38307>>>        WebSet pbRender of oEditBtn to False
38308>>>        WebSet pbRender of oSaveBtn to False
38309>>>        WebSet pbRender of oCancelChangesBtn to False
38310>>>        WebSet pbRender of oDeleteBtn to False
38311>>>
38311>>>        If (NavigateData.bReadOnly) Begin
38313>>>            WebSet pbRender of oEditBtn to True
38314>>>        End
38314>>>>
38314>>>        Else Begin
38315>>>            WebSet pbRender of oSaveBtn to True
38316>>>            WebSet pbRender of oCancelChangesBtn to True
38317>>>            WebSet pbRender of oDeleteBtn to bHasRecord
38318>>>        End
38318>>>>
38318>>>    End_Procedure
