39160>>>    // =====================================================
39160>>>    // CARGAR POSICIONES ASIGNADAS AL JUGADOR
39160>>>    // =====================================================
39160>>>
39160>>>    Procedure CargarPosicionesAsignadas
39163>>>
39163>>>        Integer iJugadorID
39163>>>
39163>>>        Get piJugadorID to iJugadorID
39164>>>
39164>>>        If (iJugadorID > 0) Begin
39166>>>
39166>>>            // Limpiar la estructura de consulta
39166>>>            Send Clear_All of oJugadorPosicion_DD
39167>>>
39167>>>            // Recuperar el jugador padre actual
39167>>>            Move iJugadorID to jugador.ID
39168>>>            Send Find of oJugador_DD EQ 1
39169>>>
39169>>>            If (Found) Begin
39171>>>
39171>>>                // Reconstruir la relación con el jugador actual
39171>>>                Send RebuildAllConstraints of oJugadorPosicion_DD
39172>>>
39172>>>                // Mostrar las relaciones de este jugador
39172>>>                Send FindFromTop of oListaAsignadas
39173>>>
39173>>>            End
39173>>>>
39173>>>
39173>>>        End
39173>>>>
39173>>>
39173>>>    End_Procedure
39174>>>
39174>>>
39174>>>    // =====================================================
39174>>>    // AÑADIR UNA POSICIÓN AL JUGADOR
39174>>>    // =====================================================
39174>>>
39174>>>    Procedure AgregarPosicion
39177>>>
39177>>>        Integer iJugadorID
39177>>>        Integer iPosicionID
39177>>>        Boolean bEncontrada
39177>>>        Boolean bDuplicada
39177>>>        Boolean bError
39177>>>        Boolean bTieneRegistro
39177>>>
39177>>>        Get piJugadorID to iJugadorID
39178>>>        Get piPosicionSeleccionada to iPosicionID
39179>>>
39179>>>        If (iJugadorID <= 0) Begin
39181>>>            Send UserError "No se ha seleccionado un jugador válido" "ERROR"
39182>>>            Procedure_Return
39183>>>        End
39183>>>>
39183>>>
39183>>>        If (iPosicionID <= 0) Begin
39185>>>            Send UserError "Selecciona primero una posición de la lista izquierda" "AVISO"
39186>>>            Procedure_Return
39187>>>        End
39187>>>>
39187>>>
39187>>>
39187>>>        // PASO 1: Comprobar que el jugador existe
39187>>>        Send Clear_All of oJugadorPosicion_DD
39188>>>
39188>>>        Move iJugadorID to jugador.ID
39189>>>        Send Find of oJugador_DD EQ 1
39190>>>
39190>>>        If (not(Found)) Begin
39192>>>            Send UserError "No se ha encontrado el jugador" "ERROR"
39193>>>            Procedure_Return
39194>>>        End
39194>>>>
39194>>>
39194>>>
39194>>>        // PASO 2: Reconstruir la relación del jugador actual
39194>>>        Send RebuildAllConstraints of oJugadorPosicion_DD
39195>>>
39195>>>
39195>>>        // PASO 3: Comprobar si la posición ya está asignada
39195>>>        Move False to bDuplicada
39196>>>
39196>>>        // El índice 2 comienza por JugadorID
39196>>>        Send Find of oJugadorPosicion_DD FIRST_RECORD 2
39197>>>
39197>>>        Move Found to bEncontrada
39198>>>
39198>>>        While (bEncontrada and (not(bDuplicada)))
39202>>>
39202>>>            If ((jugadorposicion.JugadorID = iJugadorID) and ;                (jugadorposicion.PosicionID = iPosicionID)) Begin
39204>>>
39204>>>                Move True to bDuplicada
39205>>>
39205>>>            End
39205>>>>
39205>>>            Else Begin
39206>>>
39206>>>                Send Find of oJugadorPosicion_DD NEXT_RECORD 2
39207>>>                Move Found to bEncontrada
39208>>>
39208>>>            End
39208>>>>
39208>>>
39208>>>        Loop
39209>>>>
39209>>>
39209>>>        If (bDuplicada) Begin
39211>>>            Send UserError "Posicion ya asignada" "ERROR"
39212>>>            Procedure_Return
39213>>>        End
39213>>>>
39213>>>
39213>>>
39213>>>        // PASO 4: Preparar la estructura independiente de inserción
39213>>>        // Limpiar todos sus DDO, incluidos sus padres
39213>>>        Send Clear_All of oJugadorPosicionSave_DD
39214>>>
39214>>>        // Comprobar que el registro de relación es nuevo
39214>>>        Get HasRecord of oJugadorPosicionSave_DD to bTieneRegistro
39215>>>
39215>>>        If (bTieneRegistro) Begin
39217>>>            Send UserError "No se ha podido preparar un registro nuevo" "ERROR"
39218>>>            Procedure_Return
39219>>>        End
39219>>>>
39219>>>
39219>>>
39219>>>        // PASO 5: Recuperar el jugador en la estructura de inserción
39219>>>        Move iJugadorID to jugador.ID
39220>>>        Send Find of oJugadorSave_DD EQ 1
39221>>>
39221>>>        If (not(Found)) Begin
39223>>>            Send UserError "No se ha encontrado el jugador para guardar la relación" "ERROR"
39224>>>            Procedure_Return
39225>>>        End
39225>>>>
39225>>>
39225>>>
39225>>>        // PASO 6: Recuperar la posición en la estructura de inserción
39225>>>        Move iPosicionID to posicion.ID
39226>>>        Send Find of oPosicionSave_DD EQ 1
39227>>>
39227>>>        If (not(Found)) Begin
39229>>>            Send UserError "No se ha encontrado la posición para guardar la relación" "ERROR"
39230>>>            Procedure_Return
39231>>>        End
39231>>>>
39231>>>
39231>>>
39231>>>        // PASO 7: Asignar los campos de la nueva relación
39231>>>        // El ID se genera automáticamente en MySQL
39231>>>
39231>>>        Set Field_Changed_Value of oJugadorPosicionSave_DD ;            Field jugadorposicion.JugadorID to iJugadorID
39232>>>
39232>>>        Set Field_Changed_Value of oJugadorPosicionSave_DD ;            Field jugadorposicion.PosicionID to iPosicionID
39233>>>
39233>>>
39233>>>        // PASO 8: Comprobar que el DDO sigue siendo nuevo
39233>>>        Get HasRecord of oJugadorPosicionSave_DD to bTieneRegistro
39234>>>
39234>>>        If (bTieneRegistro) Begin
39236>>>            Send UserError "El DDO de inserción contiene un registro anterior. Se cancela el guardado." "ERROR"
39237>>>            Procedure_Return
39238>>>        End
39238>>>>
39238>>>
39238>>>
39238>>>        // PASO 9: Validar los campos obligatorios
39238>>>        Get Request_Validate of oJugadorPosicionSave_DD to bError
39239>>>
39239>>>        If (bError) Begin
39241>>>            Send UserError "No se pueden validar JugadorID y PosicionID" "ERROR"
39242>>>            Procedure_Return
39243>>>        End
39243>>>>
39243>>>
39243>>>
39243>>>        // PASO 10: Insertar una NUEVA fila en MySQL
39243>>>        Send Request_Save of oJugadorPosicionSave_DD
39244>>>
39244>>>        Move (Err) to bError
39245>>>
39245>>>        If (bError) Begin
39247>>>            Send UserError "No se pudo insertar la nueva posición del jugador" "ERROR"
39248>>>            Procedure_Return
39249>>>        End
39249>>>>
39249>>>
39249>>>
39249>>>        // Limpiar las selecciones
39249>>>        Set piPosicionSeleccionada to 0
39250>>>        Set piJugadorPosicionSeleccionada to 0
39251>>>        Set piPosicionDerechaSeleccionada to 0
39252>>>
39252>>>
39252>>>        // Actualizar las posiciones asignadas
39252>>>        Send CargarPosicionesAsignadas
39253>>>
39253>>>        // Mantener visible la lista completa de posiciones
39253>>>        Send CargarPosicionesDisponibles
39254>>>
39254>>>    End_Procedure
