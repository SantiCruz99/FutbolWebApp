36988>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
36989>>>>>    
36989>>>>>    Procedure Construct_Object
36991>>>>>        Handle hoObj
36991>>>>>        
36991>>>>>        Forward Send Construct_Object
36993>>>>>        
36993>>>>>        Set pbSessionCookieHttpOnly to True
36994>>>>>        
36994>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
36995>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
36996>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
36997>>>>>        
36997>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
36998>>>>>        Set phoUserDD to hoObj
36999>>>>>        
36999>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
37000>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
37001>>>>>        Set phoSessionDD to hoObj
37002>>>>>        
37002>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
37003>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
37004>>>>>        Set phoCrypto to hoObj
37005>>>>>        
37005>>>>>        Property Boolean pbPasswordHashing True
37006>>>>>        
37006>>>>>        Property Boolean pbCreatingNewSession False
37007>>>>>        Property String psLoginName
37008>>>>>        Property String psUserName ""
37009>>>>>        Property Integer piUserRights 0
37010>>>>>    End_Procedure
37011>>>>>    
37011>>>>>    Procedure End_Construct_Object
37013>>>>>        Forward Send End_Construct_Object
37015>>>>>        
37015>>>>>        Handle hoCrypto
37015>>>>>        Integer iFieldLen
37015>>>>>        If (pbPasswordHashing(Self)) Begin
37017>>>>>            Get phoCrypto to hoCrypto
37018>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
37021>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
37023>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
37024>>>>>>
37024>>>>>            End
37024>>>>>>
37024>>>>>        End
37024>>>>>>
37024>>>>>    End_Procedure
37025>>>>>    
37025>>>>>    Function CreateSession String sRemoteAddress Returns String
37027>>>>>        String sSessionKey
37027>>>>>        Integer iErr
37027>>>>>        Boolean bLogWebSession
37027>>>>>        Handle hoSessionDD       
37027>>>>>        Get phoSessionDD to hoSessionDD
37028>>>>>        
37028>>>>>        //  Get session key
37028>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
37030>>>>>        
37030>>>>>        Get pbLogWebSession to bLogWebSession
37031>>>>>        If not bLogWebSession Begin
37033>>>>>            Function_Return sSessionKey        
37034>>>>>        End
37034>>>>>>
37034>>>>>
37034>>>>>        //  Store session
37034>>>>>        Send Clear of hoSessionDD
37035>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
37036>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
37037>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
37038>>>>>        Get Request_Validate of hoSessionDD to iErr
37039>>>>>        If (iErr) Begin
37041>>>>>            // this should not happen. If it does its a programming error
37041>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37042>>>>>>
37042>>>>>            Function_Return ""
37043>>>>>        End
37043>>>>>>
37043>>>>>        Send Request_Save of hoSessionDD
37044>>>>>        If (Err) Begin
37046>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
37046>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
37047>>>>>>
37047>>>>>            Function_Return ""
37048>>>>>        End
37048>>>>>>
37048>>>>>       
37048>>>>>        Function_Return sSessionKey        
37049>>>>>    End_Function
37050>>>>>    
37050>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
37052>>>>>        DateTime dtLastAccess dtCurrent
37052>>>>>        TimeSpan tsDiff
37052>>>>>        Integer iErr iSessionTimeout iSpanMinutes
37052>>>>>        Boolean bResult bCreatingNewSession
37052>>>>>        Boolean bLogWebSession bLoadWebApp
37052>>>>>        Integer eLoginMode
37052>>>>>        String sTime
37052>>>>>        Handle hoSessionDD hoUserDD       
37052>>>>>        
37052>>>>>        Move False to bLoadWebApp
37053>>>>>        If (num_arguments >= 2) Begin
37055>>>>>            Move bOptLoadWebApp to bLoadWebApp
37056>>>>>        End
37056>>>>>>
37056>>>>>        
37056>>>>>        Get phoSessionDD to hoSessionDD
37057>>>>>        Get phoUserDD to hoUserDD
37058>>>>>        
37058>>>>>        Get pbLogWebSession to bLogWebSession
37059>>>>>        Get peLoginMode to eLoginMode
37060>>>>>        
37060>>>>>        // for this object, you can only disable logging if login completely is disabled
37060>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
37062>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
37063>>>>>>
37063>>>>>            Function_Return False
37064>>>>>        End
37064>>>>>>
37064>>>>>
37064>>>>>        //  Clear session properties
37064>>>>>        Set psSessionKey to ""
37065>>>>>        Send UpdateSessionProperties True
37066>>>>>        
37066>>>>>        If not bLogWebSession Begin
37068>>>>>            Forward Get ValidateSession sSessionKey to bResult
37070>>>>>            Function_Return bResult
37071>>>>>        End        
37071>>>>>>
37071>>>>>        
37071>>>>>        Move False to bResult
37072>>>>>        Get piSessionTimeout to iSessionTimeout 
37073>>>>>        
37073>>>>>        //  Check if session exists
37073>>>>>        Send Clear of hoSessionDD
37074>>>>>        Move sSessionKey to WebAppSession.SessionKey
37075>>>>>        Send Find of hoSessionDD EQ Index.1
37076>>>>>            
37076>>>>>        If (Found) Begin
37078>>>>>            //  Calculate timespan between now and last access time
37078>>>>>            Move (CurrentDateTime()) to dtCurrent
37079>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
37080>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
37081>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
37082>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
37083>>>>>            
37083>>>>>            //  Check if session didn't time out
37083>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
37085>>>>>                Forward Get ValidateSession sSessionKey to bResult
37087>>>>>                   
37087>>>>>                If (bResult) Begin
37089>>>>>                    //  Update session record
37089>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
37090>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
37091>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
37092>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
37093>>>>>                    Get Request_Validate of hoSessionDD to iErr
37094>>>>>                    If (iErr) Begin
37096>>>>>                        // this should not happen. If it does its a programming error
37096>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37097>>>>>>
37097>>>>>                        Function_Return False
37098>>>>>                    End
37098>>>>>>
37098>>>>>                    Send Request_Save of hoSessionDD
37099>>>>>                    
37099>>>>>                    //  Update user properties
37099>>>>>                    Send UpdateSessionProperties False
37100>>>>>                End
37100>>>>>>
37100>>>>>            End
37100>>>>>>
37100>>>>>            Else Begin
37101>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
37101>>>>>                Get pbCreatingNewSession to bCreatingNewSession
37102>>>>>                
37102>>>>>                If (not(bCreatingNewSession)) Begin
37104>>>>>                    If (not(bLoadWebApp)) Begin
37106>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
37107>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
37108>>>>>>
37108>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
37109>>>>>                    End
37109>>>>>>
37109>>>>>                    Else Begin
37110>>>>>                        Set pbCreatingNewSession to True                    
37111>>>>>                        Get RecreateSession of ghoWebApp to bResult 
37112>>>>>                        Set pbCreatingNewSession to False                        
37113>>>>>                    End
37113>>>>>>
37113>>>>>                End
37113>>>>>>
37113>>>>>            End
37113>>>>>>
37113>>>>>        End
37113>>>>>>
37113>>>>>        Else Begin
37114>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
37115>>>>>>
37115>>>>>        End
37115>>>>>>
37115>>>>>        
37115>>>>>        Function_Return bResult
37116>>>>>    End_Function
37117>>>>>    
37117>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
37119>>>>>        If (not(pbPasswordHashing(Self))) Begin
37121>>>>>            Move sPassword to sHash
37122>>>>>            Function_Return True
37123>>>>>        End
37123>>>>>>
37123>>>>>        
37123>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
37125>>>>>            Function_Return False
37126>>>>>        End
37126>>>>>>
37126>>>>>        Move ("V1$" + sHash) to sHash
37127>>>>>        Function_Return True
37128>>>>>    End_Function
37129>>>>>    
37129>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
37131>>>>>        If (not(pbPasswordHashing(Self))) Begin
37133>>>>>            Move False to bShouldUpgrade
37134>>>>>            Function_Return (sUserPassword = sEnteredPassword)
37135>>>>>        End
37135>>>>>>
37135>>>>>        
37135>>>>>        String sVersion
37135>>>>>        Move (Left(sUserPassword, 3)) to sVersion
37136>>>>>        If (sVersion = "V1$") Begin
37138>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
37141>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
37142>>>>>        End
37142>>>>>>
37142>>>>>        Else Begin
37143>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
37146>>>>>            Function_Return False
37147>>>>>        End
37147>>>>>>
37147>>>>>    End_Function
37148>>>>>    
37148>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
37150>>>>>        Handle hoUserDD
37150>>>>>        Integer iErr
37150>>>>>        Get phoUserDD to hoUserDD
37151>>>>>        
37151>>>>>        //  Find the user
37151>>>>>        Send Clear of hoUserDD
37152>>>>>        Move sLoginName to WebAppUser.LoginName
37153>>>>>        Send Find of hoUserDD EQ Index.1
37154>>>>>        If (Found) Begin
37156>>>>>            Send Clear of hoUserDD
37157>>>>>            Function_Return False
37158>>>>>        End
37158>>>>>>
37158>>>>>        
37158>>>>>        Send Clear of hoUserDD
37159>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37160>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37161>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37163>>>>>            Send Clear of hoUserDD
37164>>>>>            Function_Return False
37165>>>>>        End
37165>>>>>>
37165>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37166>>>>>        Get Request_Validate of hoUserDD to iErr
37167>>>>>        If (iErr) Begin
37169>>>>>            Send Clear of hoUserDD
37170>>>>>            Function_Return False
37171>>>>>        End
37171>>>>>>
37171>>>>>        
37171>>>>>        Send Request_Save of hoUserDD
37172>>>>>        Function_Return (not(Err))
37173>>>>>    End_Function
37174>>>>>    
37174>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37176>>>>>        String sSessionKey sUserPassword
37176>>>>>        Handle hoSessionDD hoUserDD
37176>>>>>        Boolean bMatch bUpgrade
37176>>>>>        
37176>>>>>        Get phoSessionDD to hoSessionDD
37177>>>>>        Get phoUserDD to hoUserDD
37178>>>>>        Integer iErr eLoginMode
37178>>>>>        
37178>>>>>        // Refind session record
37178>>>>>        Get psSessionKey to sSessionKey
37179>>>>>        Send Clear of hoSessionDD
37180>>>>>        Move sSessionKey to WebAppSession.SessionKey
37181>>>>>        Send Find of hoSessionDD EQ Index.1
37182>>>>>        
37182>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37184>>>>>            Get peLoginMode to eLoginMode
37185>>>>>            
37185>>>>>            //  Find the user
37185>>>>>            Move sLoginName to WebAppUser.LoginName
37186>>>>>            Send Find of hoUserDD EQ Index.1
37187>>>>>            
37187>>>>>            // Check username and password
37187>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37189>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37190>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37191>>>>>                
37191>>>>>                If (bMatch) Begin
37193>>>>>                    // Store the login
37193>>>>>                    If (bUpgrade) Begin
37195>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37196>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37199>>>>>                    End
37199>>>>>>
37199>>>>>                    Set Field_Changed_Value of hoUserDD Field WebAppUser.LastLogin to (CurrentDateTime())
37200>>>>>                    Get Request_Validate of hoSessionDD to iErr
37201>>>>>                    If (iErr) Begin
37203>>>>>                        // this should not happen. If it does its a programming error
37203>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37204>>>>>>
37204>>>>>                        Function_Return False
37205>>>>>                    End
37205>>>>>>
37205>>>>>                    
37205>>>>>                    Send Request_Save of hoSessionDD
37206>>>>>                    
37206>>>>>                    // Update session properties
37206>>>>>                    Send UpdateSessionProperties False
37207>>>>>                    Send NotifyChangeRights
37208>>>>>                    Function_Return True
37209>>>>>                End
37209>>>>>>
37209>>>>>                Else Begin
37210>>>>>                    //  We should rely directly on this buffer elsewhere but just be sure
37210>>>>>                    Send Clear of hoUserDD
37211>>>>>                End
37211>>>>>>
37211>>>>>            End
37211>>>>>>
37211>>>>>            Else Begin
37212>>>>>                // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37212>>>>>                Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37213>>>>>            End
37213>>>>>>
37213>>>>>        End
37213>>>>>>
37213>>>>>        Else Begin
37214>>>>>            // This is added to delay latency to avoid hackers finding out whether the user exists or not.
37214>>>>>            Get CreatePasswordHash "This is to delay the response latency." (&sPassword) to iErr
37215>>>>>        End
37215>>>>>>
37215>>>>>          
37215>>>>>        Function_Return False
37216>>>>>    End_Function
37217>>>>>    
37217>>>>>    Function SetUserPassword String sLoginName String sPassword Returns Boolean
37219>>>>>        Handle hoUserDD
37219>>>>>        Integer iErr
37219>>>>>        Get phoUserDD to hoUserDD
37220>>>>>        
37220>>>>>        //  Find the user
37220>>>>>        Send Clear of hoUserDD
37221>>>>>        Move sLoginName to WebAppUser.LoginName
37222>>>>>        Send Find of hoUserDD EQ Index.1
37223>>>>>        If (not(Found)) Begin
37225>>>>>            Send Clear of hoUserDD
37226>>>>>            Function_Return False
37227>>>>>        End
37227>>>>>>
37227>>>>>        
37227>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37229>>>>>            Send Clear of hoUserDD
37230>>>>>            Function_Return False
37231>>>>>        End
37231>>>>>>
37231>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37232>>>>>        Get Request_Validate of hoUserDD to iErr
37233>>>>>        If (iErr) Begin
37235>>>>>            Send Clear of hoUserDD
37236>>>>>            Function_Return False
37237>>>>>        End
37237>>>>>>
37237>>>>>        
37237>>>>>        Send Request_Save of hoUserDD
37238>>>>>        Function_Return (not(Err))
37239>>>>>    End_Function
