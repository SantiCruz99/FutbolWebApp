39255>>>    // =====================================================
39255>>>    // QUITAR UNA POSICIÓN DEL JUGADOR
39255>>>    // =====================================================
39255>>>
39255>>>    Procedure QuitarPosicion
39258>>>
39258>>>        Integer iJugadorID
39258>>>        Integer iRelacionID
39258>>>        Integer iPosicionID
39258>>>        Boolean bError
39258>>>
39258>>>        Get piJugadorID to iJugadorID
39259>>>        Get piJugadorPosicionSeleccionada to iRelacionID
39260>>>        Get piPosicionDerechaSeleccionada to iPosicionID
39261>>>
39261>>>        // Comprobar que se ha seleccionado una asignación en la derecha
39261>>>        If (iRelacionID <= 0) Begin
39263>>>            Send UserError "Selecciona primero la posición que deseas quitar en la lista derecha" "AVISO"
39264>>>            Procedure_Return
39265>>>        End
39265>>>>
39265>>>
39265>>>        If (iJugadorID <= 0) Begin
39267>>>            Send UserError "No se ha seleccionado un jugador válido" "ERROR"
39268>>>            Procedure_Return
39269>>>        End
39269>>>>
39269>>>
39269>>>
39269>>>        // Recuperar el jugador padre actual
39269>>>        Send Clear_All of oJugadorPosicion_DD
39270>>>
39270>>>        Move iJugadorID to jugador.ID
39271>>>        Send Find of oJugador_DD EQ 1
39272>>>
39272>>>        If (not(Found)) Begin
39274>>>            Send UserError "No se ha encontrado el jugador" "ERROR"
39275>>>            Procedure_Return
39276>>>        End
39276>>>>
39276>>>
39276>>>
39276>>>        // Reconstruir el filtro correspondiente al jugador actual
39276>>>        Send RebuildAllConstraints of oJugadorPosicion_DD
39277>>>
39277>>>
39277>>>        // Recuperar solamente la relación seleccionada
39277>>>        Move iRelacionID to jugadorposicion.ID
39278>>>        Send Find of oJugadorPosicion_DD EQ 1
39279>>>
39279>>>        If (not(Found)) Begin
39281>>>            Send UserError "La asignación seleccionada ya no existe para este jugador" "ERROR"
39282>>>            Procedure_Return
39283>>>        End
39283>>>>
39283>>>
39283>>>
39283>>>        // Comprobar que la relación pertenece al jugador actual
39283>>>        If (jugadorposicion.JugadorID <> iJugadorID) Begin
39285>>>            Send UserError "La posición seleccionada no pertenece a este jugador" "ERROR"
39286>>>            Procedure_Return
39287>>>        End
39287>>>>
39287>>>
39287>>>        If (jugadorposicion.PosicionID <> iPosicionID) Begin
39289>>>            Send UserError "La asignación seleccionada ha cambiado. Vuelve a seleccionarla" "ERROR"
39290>>>            Procedure_Return
39291>>>        End
39291>>>>
39291>>>
39291>>>
39291>>>        // Eliminar únicamente la relación jugador-posicion seleccionada
39291>>>        Send Request_Delete of oJugadorPosicion_DD
39292>>>
39292>>>        Move (Err) to bError
39293>>>
39293>>>        If (bError) Begin
39295>>>            Send UserError "No se pudo quitar la posición del jugador" "ERROR"
39296>>>            Procedure_Return
39297>>>        End
39297>>>>
39297>>>
39297>>>
39297>>>        // Limpiar las selecciones
39297>>>        Set piJugadorPosicionSeleccionada to 0
39298>>>        Set piPosicionDerechaSeleccionada to 0
39299>>>        Set piPosicionSeleccionada to 0
39300>>>
39300>>>
39300>>>        // Actualizar las posiciones asignadas
39300>>>        Send CargarPosicionesAsignadas
39301>>>
39301>>>        // Mantener la lista izquierda completa
39301>>>        Send CargarPosicionesDisponibles
39302>>>
39302>>>    End_Procedure
39303>>>
