39220>>>        Get HasRecord of oJugadorPosicionSave_DD to bTieneRegistro
39221>>>
39221>>>        If (bTieneRegistro) Begin
39223>>>            Send UserError "No se ha podido preparar un registro nuevo" "ERROR"
39224>>>            Procedure_Return
39225>>>        End
39225>>>>
39225>>>
39225>>>
39225>>>        // PASO 5: Recuperar el jugador en la estructura de inserción
39225>>>        Move iJugadorID to jugador.ID
39226>>>        Send Find of oJugadorSave_DD EQ 1
39227>>>
39227>>>        If (not(Found)) Begin
39229>>>            Send UserError "No se ha encontrado el jugador para guardar la relación" "ERROR"
39230>>>            Procedure_Return
39231>>>        End
39231>>>>
39231>>>
39231>>>
39231>>>        // PASO 6: Recuperar la posición en la estructura de inserción
