37240>>>>>    Function IsLoggedIn Returns Boolean
37242>>>>>        String sLoginName
37242>>>>>        Boolean bLogWebSession bLoggedIn
37242>>>>>        
37242>>>>>        Get pbLogWebSession to bLogWebSession
37243>>>>>        If not bLogWebSession Begin
37245>>>>>            Forward Get IsLoggedIn to bLoggedIn
37247>>>>>            Function_Return bLoggedIn
37248>>>>>        End
37248>>>>>>
37248>>>>>        
37248>>>>>        Get psLoginName to sLoginName
37249>>>>>        
37249>>>>>        Function_Return (sLoginName <> "")
37250>>>>>    End_Function
37251>>>>>    
37251>>>>>    
37251>>>>>    //
37251>>>>>    // This procedure is called when validating a session and after logging in. Its purpose is to 
37251>>>>>    // update properties based on the session and user data. Augment this function to update 
37251>>>>>    // properties based on the session / user table. Note that WebAppUser and WebAppSession contain
37251>>>>>    // the right records when this procedure is called.
37251>>>>>    //
37251>>>>>    // Params:
37251>>>>>    //      bClear   True if the procedure is called before session validation to clear properties.
37251>>>>>    //
37251>>>>>    Procedure UpdateSessionProperties Boolean bClear
37253>>>>>        Handle hoUserDD
37253>>>>>        
37253>>>>>        Get phoUserDD to hoUserDD
37254>>>>>        
37254>>>>>        //  Update user properties
37254>>>>>        If (not(bClear) and HasRecord(hoUserDD)) Begin
37256>>>>>            Set psUsername to (Trim(WebAppUser.FullName))
37257>>>>>            Set psLoginName to (Trim(WebAppUser.LoginName))
37258>>>>>            Set piUserRights to WebAppUser.Rights
37259>>>>>            
37259>>>>>            Send OnSessionPropertiesSet 
37260>>>>>        End
37260>>>>>>
37260>>>>>        Else Begin
37261>>>>>            Set psUsername to ""
37262>>>>>            Set psLoginName to ""
37263>>>>>            Set piUserRights to 0
37264>>>>>            
37264>>>>>            Send OnSessionPropertiesClear
37265>>>>>        End
37265>>>>>>
37265>>>>>    End_Procedure
37266>>>>>    
37266>>>>>    Procedure OnSessionPropertiesSet
37268>>>>>        //  Empty event stub
37268>>>>>    End_Procedure
37269>>>>>    
37269>>>>>    Procedure OnSessionPropertiesClear
37271>>>>>        //  Empty event stub
37271>>>>>    End_Procedure
37272>>>>>    
37272>>>>>    Procedure EndSession
37274>>>>>        Integer iErr
37274>>>>>        Boolean bLogWebSession
37274>>>>>        Handle hoSessionDD       
37274>>>>>        
37274>>>>>        Get phoSessionDD to hoSessionDD
37275>>>>>        Get pbLogWebSession to bLogWebSession
37276>>>>>        If not bLogWebSession Begin
37278>>>>>            Forward Send EndSession
37280>>>>>            Procedure_Return
37281>>>>>        End
37281>>>>>>
37281>>>>>            
37281>>>>>        //  Check if session exists
37281>>>>>        Send Clear of hoSessionDD
37282>>>>>        Get psSessionKey to WebAppSession.SessionKey
37283>>>>>        
37283>>>>>        Send Find of hoSessionDD EQ Index.1
37284>>>>>        If (Found) Begin
37286>>>>>            Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "N"
37287>>>>>            Get Request_Validate of hoSessionDD to iErr
37288>>>>>            If (iErr) Begin
37290>>>>>                // this should not happen. If it does its a programming error
37290>>>>>                Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37291>>>>>>
37291>>>>>                Procedure_Return
37292>>>>>            End
37292>>>>>>
37292>>>>>            Send Request_Save of hoSessionDD
37293>>>>>        End
37293>>>>>>
37293>>>>>    End_Procedure
37294>>>>>
37294>>>>>End_Class
