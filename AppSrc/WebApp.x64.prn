37005>>>>>Class cWebSessionManagerStandard is a cWebSessionManager
37006>>>>>    
37006>>>>>    Procedure Construct_Object
37008>>>>>        Handle hoObj
37008>>>>>        
37008>>>>>        Forward Send Construct_Object
37010>>>>>        
37010>>>>>        Set pbSessionCookieHttpOnly to True
37011>>>>>        
37011>>>>>        Property Handle phoUserDD 0      // Handle to the WebAppUser DDO
37012>>>>>        Property Handle phoSessionDD 0   // Handle to the WebAppSession DDO  
37013>>>>>        Property Handle phoCrypto 0      // Handle to the PasswordHasher
37014>>>>>        
37014>>>>>        Get CreateNamed (RefClass(cWebAppUserDataDictionary)) 'oUserDD' to hoObj
37015>>>>>        Set phoUserDD to hoObj
37016>>>>>        
37016>>>>>        Get CreateNamed (RefClass(cWebAppSessionDataDictionary)) 'oSessionDD' to hoObj
37017>>>>>        Set DDO_Server of hoObj to (phoUserDD(Self))
37018>>>>>        Set phoSessionDD to hoObj
37019>>>>>        
37019>>>>>        Property Handle phoCrypto 0   // Handle to the Cryptographer
37020>>>>>        Get CreateNamed (RefClass(cPasswordHasher)) 'oCrypto' to hoObj
37021>>>>>        Set phoCrypto to hoObj
37022>>>>>        
37022>>>>>        Property Boolean pbPasswordHashing True
37023>>>>>        
37023>>>>>        Property Boolean pbCreatingNewSession False
37024>>>>>        Property String psLoginName
37025>>>>>        Property String psUserName ""
37026>>>>>        Property Integer piUserRights 0
37027>>>>>    End_Procedure
37028>>>>>    
37028>>>>>    Procedure End_Construct_Object
37030>>>>>        Forward Send End_Construct_Object
37032>>>>>        
37032>>>>>        Handle hoCrypto
37032>>>>>        Integer iFieldLen
37032>>>>>        If (pbPasswordHashing(Self)) Begin
37034>>>>>            Get phoCrypto to hoCrypto
37035>>>>>            Get_Attribute DF_FIELD_LENGTH of (RefTable(WebAppUser)) (RefTable(WebAppUser.Password)) to iFieldLen
37038>>>>>            If (iFieldLen < (RequiredBufferSize(hoCrypto) + 3)) Begin
37040>>>>>                Error DFERR_PROGRAM "The password field of WebAppUser is not large enough (128)"
37041>>>>>>
37041>>>>>            End
37041>>>>>>
37041>>>>>        End
37041>>>>>>
37041>>>>>    End_Procedure
37042>>>>>    
37042>>>>>    Function CreateSession String sRemoteAddress Returns String
37044>>>>>        String sSessionKey
37044>>>>>        Integer iErr
37044>>>>>        Boolean bLogWebSession
37044>>>>>        Handle hoSessionDD       
37044>>>>>        Get phoSessionDD to hoSessionDD
37045>>>>>        
37045>>>>>        //  Get session key
37045>>>>>        Forward Get CreateSession sRemoteAddress to sSessionKey
37047>>>>>        
37047>>>>>        Get pbLogWebSession to bLogWebSession
37048>>>>>        If not bLogWebSession Begin
37050>>>>>            Function_Return sSessionKey        
37051>>>>>        End
37051>>>>>>
37051>>>>>
37051>>>>>        //  Store session
37051>>>>>        Send Clear of hoSessionDD
37052>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.SessionKey to sSessionKey
37053>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.RemoteAddress to sRemoteAddress
37054>>>>>        Set Field_Changed_Value of hoSessionDD Field WebAppSession.Active to "Y"
37055>>>>>        Get Request_Validate of hoSessionDD to iErr
37056>>>>>        If (iErr) Begin
37058>>>>>            // this should not happen. If it does its a programming error
37058>>>>>            Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37059>>>>>>
37059>>>>>            Function_Return ""
37060>>>>>        End
37060>>>>>>
37060>>>>>        Send Request_Save of hoSessionDD
37061>>>>>        If (Err) Begin
37063>>>>>            // this shouldn't happen, if it does likely a duplicate session key issue, even through request_save already gave an error we give another one to make tracking down easier
37063>>>>>            Error DFERR_PROGRAM C_$WebAppSessionSaveFailed
37064>>>>>>
37064>>>>>            Function_Return ""
37065>>>>>        End
37065>>>>>>
37065>>>>>       
37065>>>>>        Function_Return sSessionKey        
37066>>>>>    End_Function
37067>>>>>    
37067>>>>>    Function ValidateSession String sSessionKey Boolean bOptLoadWebApp Returns Boolean
37069>>>>>        DateTime dtLastAccess dtCurrent
37069>>>>>        TimeSpan tsDiff
37069>>>>>        Integer iErr iSessionTimeout iSpanMinutes
37069>>>>>        Boolean bResult bCreatingNewSession
37069>>>>>        Boolean bLogWebSession bLoadWebApp
37069>>>>>        Integer eLoginMode
37069>>>>>        String sTime
37069>>>>>        Handle hoSessionDD hoUserDD       
37069>>>>>        
37069>>>>>        Move False to bLoadWebApp
37070>>>>>        If (num_arguments >= 2) Begin
37072>>>>>            Move bOptLoadWebApp to bLoadWebApp
37073>>>>>        End
37073>>>>>>
37073>>>>>        
37073>>>>>        Get phoSessionDD to hoSessionDD
37074>>>>>        Get phoUserDD to hoUserDD
37075>>>>>        
37075>>>>>        Get pbLogWebSession to bLogWebSession
37076>>>>>        Get peLoginMode to eLoginMode
37077>>>>>        
37077>>>>>        // for this object, you can only disable logging if login completely is disabled
37077>>>>>        If (not(bLogWebSession) and (eLoginMode<>lmLoginNone)) Begin
37079>>>>>            Error DFERR_PROGRAM C_$WebSessionLoggingMustBeEnabled
37080>>>>>>
37080>>>>>            Function_Return False
37081>>>>>        End
37081>>>>>>
37081>>>>>
37081>>>>>        //  Clear session properties
37081>>>>>        Set psSessionKey to ""
37082>>>>>        Send UpdateSessionProperties True
37083>>>>>        
37083>>>>>        If not bLogWebSession Begin
37085>>>>>            Forward Get ValidateSession sSessionKey to bResult
37087>>>>>            Function_Return bResult
37088>>>>>        End        
37088>>>>>>
37088>>>>>        
37088>>>>>        Move False to bResult
37089>>>>>        Get piSessionTimeout to iSessionTimeout 
37090>>>>>        
37090>>>>>        //  Check if session exists
37090>>>>>        Send Clear of hoSessionDD
37091>>>>>        Move sSessionKey to WebAppSession.SessionKey
37092>>>>>        Send Find of hoSessionDD EQ Index.1
37093>>>>>            
37093>>>>>        If (Found) Begin
37095>>>>>            //  Calculate timespan between now and last access time
37095>>>>>            Move (CurrentDateTime()) to dtCurrent
37096>>>>>            Move WebAppSession.LastAccessDate to dtLastAccess
37097>>>>>            Get StringToTime of hoSessionDD dtLastAccess WebAppSession.LastAccessTime to dtLastAccess
37098>>>>>            Move (dtCurrent - dtLastAccess) to tsDiff
37099>>>>>            Move (SpanTotalMinutes(tsDiff)) to iSpanMinutes
37100>>>>>            
37100>>>>>            //  Check if session didn't time out
37100>>>>>            If (IsDateValid(dtLastAccess) and (iSessionTimeout <= 0 or (iSpanMinutes < iSessionTimeout)) and WebAppSession.Active = "Y") Begin
37102>>>>>                Forward Get ValidateSession sSessionKey to bResult
37104>>>>>                   
37104>>>>>                If (bResult) Begin
37106>>>>>                    //  Update session record
37106>>>>>                    Get TimeToString of hoSessionDD dtCurrent to sTime 
37107>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessDate to dtCurrent
37108>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.LastAccessTime to sTime
37109>>>>>                    Set Field_Changed_Value of hoSessionDD Field WebAppSession.UseCount to (WebAppSession.UseCount + 1)
37110>>>>>                    Get Request_Validate of hoSessionDD to iErr
37111>>>>>                    If (iErr) Begin
37113>>>>>                        // this should not happen. If it does its a programming error
37113>>>>>                        Error DFERR_PROGRAM C_$WebAppSessionValidateFailed
37114>>>>>>
37114>>>>>                        Function_Return False
37115>>>>>                    End
37115>>>>>>
37115>>>>>                    Send Request_Save of hoSessionDD
37116>>>>>                    
37116>>>>>                    //  Update user properties
37116>>>>>                    Send UpdateSessionProperties False
37117>>>>>                End
37117>>>>>>
37117>>>>>            End
37117>>>>>>
37117>>>>>            Else Begin
37118>>>>>                // Test the Creating New Session Flag to protect against infinite recursion....
37118>>>>>                Get pbCreatingNewSession to bCreatingNewSession
37119>>>>>                
37119>>>>>                If (not(bCreatingNewSession)) Begin
37121>>>>>                    If (not(bLoadWebApp)) Begin
37123>>>>>                        Move False to bResult   //  We can only continue immediately if we were loading the webapp, other operations are not allowed!
37124>>>>>                        Error DFERR_WEBAPP_SESSION_TIMEOUT "Your application session has timed out or is inactive, please login again."
37125>>>>>>
37125>>>>>                        Send NavigateRefresh of ghoWebApp          // refresh the WebApp at the client (triggers a login)
37126>>>>>                    End
37126>>>>>>
37126>>>>>                    Else Begin
37127>>>>>                        Set pbCreatingNewSession to True                    
37128>>>>>                        Get RecreateSession of ghoWebApp to bResult 
37129>>>>>                        Set pbCreatingNewSession to False                        
37130>>>>>                    End
37130>>>>>>
37130>>>>>                End
37130>>>>>>
37130>>>>>            End
37130>>>>>>
37130>>>>>        End
37130>>>>>>
37130>>>>>        Else Begin
37131>>>>>            Error DFERR_WEBAPP_BAD_SESSION_KEY "Session key not known (reload page to recreate session)"
37132>>>>>>
37132>>>>>        End
37132>>>>>>
37132>>>>>        
37132>>>>>        Function_Return bResult
37133>>>>>    End_Function
37134>>>>>    
37134>>>>>    Function CreatePasswordHash String sPassword String ByRef sHash Returns Boolean
37136>>>>>        If (not(pbPasswordHashing(Self))) Begin
37138>>>>>            Move sPassword to sHash
37139>>>>>            Function_Return True
37140>>>>>        End
37140>>>>>>
37140>>>>>        
37140>>>>>        If (not(CreatePasswordHash(phoCrypto(Self), sPassword, &sHash))) Begin
37142>>>>>            Function_Return False
37143>>>>>        End
37143>>>>>>
37143>>>>>        Move ("V1$" + sHash) to sHash
37144>>>>>        Function_Return True
37145>>>>>    End_Function
37146>>>>>    
37146>>>>>    Function VerifyPasswordHash String sUserPassword String sEnteredPassword Boolean ByRef bShouldUpgrade Returns Boolean
37148>>>>>        If (not(pbPasswordHashing(Self))) Begin
37150>>>>>            Move False to bShouldUpgrade
37151>>>>>            Function_Return (sUserPassword = sEnteredPassword)
37152>>>>>        End
37152>>>>>>
37152>>>>>        
37152>>>>>        String sVersion
37152>>>>>        Move (Left(sUserPassword, 3)) to sVersion
37153>>>>>        If (sVersion = "V1$") Begin
37155>>>>>            If (num_arguments > 2) Move False to bShouldUpgrade
37158>>>>>            Function_Return (VerifyPasswordHash(phoCrypto(Self), sEnteredPassword, Right(sUserPassword, Length(sUserPassword) - 3)))
37159>>>>>        End
37159>>>>>>
37159>>>>>        Else Begin
37160>>>>>            If (num_arguments > 2) Move True to bShouldUpgrade
37163>>>>>            Function_Return False
37164>>>>>        End
37164>>>>>>
37164>>>>>    End_Function
37165>>>>>    
37165>>>>>    Function UserRegister String sLoginName String sPassword Returns Boolean
37167>>>>>        Handle hoUserDD
37167>>>>>        Integer iErr
37167>>>>>        Get phoUserDD to hoUserDD
37168>>>>>        
37168>>>>>        //  Find the user
37168>>>>>        Send Clear of hoUserDD
37169>>>>>        Move sLoginName to WebAppUser.LoginName
37170>>>>>        Send Find of hoUserDD EQ Index.1
37171>>>>>        If (Found) Begin
37173>>>>>            Send Clear of hoUserDD
37174>>>>>            Function_Return False
37175>>>>>        End
37175>>>>>>
37175>>>>>        
37175>>>>>        Send Clear of hoUserDD
37176>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.FullName to sLoginName
37177>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.LoginName to sLoginName
37178>>>>>        If (not(CreatePasswordHash(Self, Trim(sPassword), &sPassword))) Begin
37180>>>>>            Send Clear of hoUserDD
37181>>>>>            Function_Return False
37182>>>>>        End
37182>>>>>>
37182>>>>>        Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37183>>>>>        Get Request_Validate of hoUserDD to iErr
37184>>>>>        If (iErr) Begin
37186>>>>>            Send Clear of hoUserDD
37187>>>>>            Function_Return False
37188>>>>>        End
37188>>>>>>
37188>>>>>        
37188>>>>>        Send Request_Save of hoUserDD
37189>>>>>        Function_Return (not(Err))
37190>>>>>    End_Function
37191>>>>>    
37191>>>>>    Function UserLogin String sLoginName String sPassword Returns Boolean
37193>>>>>        String sSessionKey sUserPassword
37193>>>>>        Handle hoSessionDD hoUserDD
37193>>>>>        Boolean bMatch bUpgrade
37193>>>>>        
37193>>>>>        Get phoSessionDD to hoSessionDD
37194>>>>>        Get phoUserDD to hoUserDD
37195>>>>>        Integer iErr eLoginMode
37195>>>>>        
37195>>>>>        // Refind session record
37195>>>>>        Get psSessionKey to sSessionKey
37196>>>>>        Send Clear of hoSessionDD
37197>>>>>        Move sSessionKey to WebAppSession.SessionKey
37198>>>>>        Send Find of hoSessionDD EQ Index.1
37199>>>>>        
37199>>>>>        If (Found and WebAppSession.SessionKey = sSessionKey) Begin
37201>>>>>            Get peLoginMode to eLoginMode
37202>>>>>            
37202>>>>>            //  Find the user
37202>>>>>            Move sLoginName to WebAppUser.LoginName
37203>>>>>            Send Find of hoUserDD EQ Index.1
37204>>>>>            
37204>>>>>            // Check username and password
37204>>>>>            If (Found and (Lowercase(sLoginName) = Lowercase(Trim(WebAppUser.LoginName)))) Begin
37206>>>>>                Get Field_Current_Value of hoUserDD Field WebAppUser.Password to sUserPassword
37207>>>>>                Get VerifyPasswordHash (Trim(sUserPassword)) (Trim(sPassword)) (&bUpgrade) to bMatch
37208>>>>>                
37208>>>>>                If (bMatch) Begin
37210>>>>>                    // Store the login
37210>>>>>                    If (bUpgrade) Begin
37212>>>>>                        Get CreatePasswordHash (Trim(sPassword)) (&sPassword) to bUpgrade
37213>>>>>                        If (bUpgrade) Set Field_Changed_Value of hoUserDD Field WebAppUser.Password to sPassword
37216>>>>>                    End
