38322>>>
38322>>>        Forward Send OnNavigateForward NavigateData
38324>>>
38324>>>        Get NamedValueGet NavigateData.NamedValues "EquipoRowId" to sRowId
38325>>>        If (sRowId <> "") Begin
38327>>>            Move (DeserializeRowId(sRowId)) to riEquipo
38328>>>            Send FindByRowId of oEquipo_DD equipo.File_Number riEquipo
38329>>>            Send Request_Assign of oEquipo_DD
38330>>>        End
38330>>>>
38330>>>
38330>>>        Send ChangeEditMode False
38331>>>        Send SetActionButtons
38332>>>    End_Procedure
