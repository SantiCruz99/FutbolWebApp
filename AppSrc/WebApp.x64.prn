37636>>>>>Procedure Update
37638>>>>>    Forward Send Update
37640>>>>>
37640>>>>>    // No contar como equipo una operación iniciada
37640>>>>>    // desde otro DDO, por ejemplo entrenador.
37640>>>>>    If (Operation_Origin = Self) Begin
37642>>>>>        Integer iNumEquipos iMaxEquipos
37642>>>>>
37642>>>>>        Move liga.Equipos to iNumEquipos
37643>>>>>        Move liga.EquiposMax to iMaxEquipos
37644>>>>>
37644>>>>>        If (iNumEquipos < iMaxEquipos) Begin
37646>>>>>            Increment iNumEquipos
37647>>>>>            Move iNumEquipos to liga.Equipos
37648>>>>>        End
37648>>>>>>
37648>>>>>        Else Begin
37649>>>>>            Send UserError "No hay sitio en la liga para el nuevo equipo" "ERROR"
37650>>>>>        End
37650>>>>>>
37650>>>>>    End
