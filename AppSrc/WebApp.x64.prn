37763>>>    Procedure OnNavigateForward tWebNavigateData NavigateData
37766>>>        String sRowId
37766>>>        RowID riEntrenador
37766>>>
37766>>>        Forward Send OnNavigateForward NavigateData
37768>>>
37768>>>        // Recuperamos el RowId enviado desde la lista de selección y buscamos el registro
37768>>>        Get NamedValueGet NavigateData.NamedValues "EntrenadorRowId" to sRowId
37769>>>        If (sRowId <> "") Begin
37771>>>            Move (DeserializeRowId(sRowId)) to riEntrenador
37772>>>            Send FindByRowId of oEntrenador_DD entrenador.File_Number riEntrenador
37773>>>            Send Request_Assign of oEntrenador_DD
37774>>>        End
37774>>>>
37774>>>
37774>>>        Send ChangeEditMode False
37775>>>        Send SetActionButtons
