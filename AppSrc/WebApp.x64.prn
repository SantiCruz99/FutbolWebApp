38291>>>        Forward Send OnNavigateForward NavigateData
38293>>>
38293>>>        Get NamedValueGet NavigateData.NamedValues "EquipoRowId" to sRowId
38294>>>        If (sRowId <> "") Begin
38296>>>            Move (DeserializeRowId(sRowId)) to riEquipo
38297>>>            Send FindByRowId of oEquipo_DD equipo.File_Number riEquipo
38298>>>            Send Request_Assign of oEquipo_DD
38299>>>        End
38299>>>>
38299>>>
38299>>>        Send ChangeEditMode False
38300>>>        Send SetActionButtons
38301>>>    End_Procedure
