37622>>>>>Procedure Backout
37624>>>>>    Forward Send Backout
37626>>>>>
37626>>>>>    // Solo modificar el contador cuando se está guardando
37626>>>>>    // o eliminando un equipo desde su propio DDO.
37626>>>>>    If (Operation_Origin = Self) Begin
37628>>>>>        Integer iNumEquipos
37628>>>>>
37628>>>>>        Move liga.Equipos to iNumEquipos
37629>>>>>
37629>>>>>        If (iNumEquipos > 0) Begin
37631>>>>>            Decrement iNumEquipos
37632>>>>>            Move iNumEquipos to liga.Equipos
37633>>>>>        End
37633>>>>>>
37633>>>>>        Else Begin
37634>>>>>            Send UserError "No hay equipos para quitar" "ERROR"
37635>>>>>        End
37635>>>>>>
37635>>>>>    End
