37851>>>    // Quitar el equipo al entrenador
37851>>>    Procedure DespedirEntrenador
37854>>>        Send ChangeEditMode True
37855>>>
37855>>>        Set Field_Changed_Value of oEntrenador_DD ;            Field entrenador.EquipoID to 0
37856>>>
37856>>>        Set_Attribute DF_FIELD_IS_NULL of entrenador.File_Number ;            (RefTable(entrenador.EquipoID)) to True
37859>>>
37859>>>        Send Request_Save of oZoomEntrenador
37860>>>    End_Procedure
