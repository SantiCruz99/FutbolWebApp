37876>>>
37876>>>        If (sRowId <> "") Begin
37878>>>            Move (DeserializeRowId(sRowId)) to riEntrenador
37879>>>
37879>>>            Send FindByRowId of oEntrenador_DD ;                entrenador.File_Number riEntrenador
37880>>>
37880>>>            Send Request_Assign of oEntrenador_DD
37881>>>        End
37881>>>>
37881>>>
37881>>>        Send ChangeEditMode True
37882>>>        Send SetActionButtons
37883>>>    End_Procedure
