
Use DataDict.pkg

Open posicion
Open jugadorposicion

Class cposicionDataDictionary is a DataDictionary

    Procedure Construct_Object
        Forward Send Construct_Object

        Set Main_File to posicion.File_Number

        Set Add_Client_File to jugadorposicion.File_Number

        Set Foreign_Field_Option DD_KEYFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_KEYFIELD DD_FINDREQ to True
        Set Foreign_Field_Option DD_INDEXFIELD DD_NOPUT to True
        Set Foreign_Field_Option DD_DEFAULT DD_DISPLAYONLY to True

        // Proteger la clave primaria para que no se modifique
        Set Key_Field_State Field posicion.ID to False

        // Bloquear el nombre para que no se pueda modificar
        Set Field_Option Field posicion.Nombre DD_NOPUT to True
        Set Field_Option Field posicion.Nombre DD_NOENTER to True

        // Marcar campos obligatorios (NOT NULL) de la tabla posicion
        Set Field_Option Field posicion.Nombre DD_REQUIRED to True

    End_Procedure

End_Class
